{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "github-copilot",
    "gitlab",
    "google-vertex-anthropic",
    "opencode"
  ],
  "formatter": true,
  "agent": {
    "title": {
      "variant": "low"
    }
  },
  "provider": {
    "litemaas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteMaaS (internal)",
      "options": {
        "baseURL": "https://litemaas.rhoai.rh-aiservices-bu.com/v1",
        "apiKey": "{env:LITEMAAS_API_KEY}"
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    },
    "local-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (Ollama)",
      "options": {
        "baseURL": "http://10.0.2.2:11434/v1"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss-20b (local)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen3.8-27B (local)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "litellm-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Proxy (Auto Routing)",
      "options": {
        "baseURL": "http://10.0.2.2:4000/v1"
      },
      "models": {
        "smart-router": {
          "name": "Smart Router (Auto-routed)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "switchyard-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard Proxy (autorouting)",
      "options": {
        "baseURL": "http://10.0.2.2:4000/v1"
      },
      "models": {
        "switchyard-auto": {
          "name": "Switchyard Auto-router (Capability Classifier)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "switchyard-stage": {
          "name": "Switchyard Stage-router (Signals & Progress)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "switchyard-random": {
          "name": "Switchyard Random-router (A/B Split)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/sandbox/**": "allow",
      "/sandbox/.*": "ask"
    }
  }
}
