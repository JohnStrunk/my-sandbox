{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "github-copilot",
    "gitlab",
    "google-vertex-anthropic",
    "opencode"
  ],
  "formatter": true,
  "agent": {
    "title": {
      "variant": "low"
    }
  },
  "provider": {
    "litemaas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteMaaS (internal)",
      "options": {
        "baseURL": "https://litemaas.rhoai.rh-aiservices-bu.com/v1",
        "apiKey": "{env:LITEMAAS_API_KEY}"
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/sandbox/**": "allow",
      "/sandbox/.*": "ask"
    }
  }
}
