#!/usr/bin/env bash
# Single-command launcher: OpenShell replacement for devcontainer launch.
#
# Runs as a fully rootless Podman container: the main process keeps the
# image's built-in "sandbox" account (via `--userns=keep-id`), so files
# created in the container land on the host owned by the invoking user,
# with no runtime UID/GID remapping or ownership fix-up required. The image
# also bundles a rootless, nested Podman (Podman-in-Podman) so the sandbox
# can build/run its own containers without the outer container needing
# --privileged or any added Linux capabilities.
#
# Bind-mounts the *current working directory* into a per-directory
# container (named "devbox-<dirname>"). This is meant to be symlinked onto
# $PATH (e.g. `ln -s /path/to/this/repo/devbox ~/bin/devbox`), so a user can
# simply `cd` into whatever project they want to work on and run `devbox`:
#   - If the container for that directory doesn't already exist, it's
#     created (building the image first, if needed) with the current
#     directory bind-mounted in.
#   - If it already exists, this just execs a shell or the provided command
#     into it (starting it first if it's currently stopped).
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BIND_DIR="$(realpath "$PWD")"
NAME="devbox-$(basename "$BIND_DIR")"
WORKDIR="/sandbox/$(basename "$BIND_DIR")"
SOURCE_FINGERPRINT_LABEL="io.github.johnstrunk.my-sandbox.devbox-context-fingerprint"
SUBID_READY_FILE="/sandbox/.devbox-subids-ready"
DEVBOX_LOCK_FD=""

# Clear XDG_DATA_HOME so `devbox` works inside vscode terminal sessions
export XDG_DATA_HOME=

usage() {
  cat <<EOF
Usage: $(basename "$0") [-r|--remove] [--recreate|--new] [-h|--help] [--] [command [arg ...]]

Bind-mounts the current directory ($BIND_DIR) into a devbox container
named '$NAME': creating it if it doesn't exist, or exec'ing a command/shell
into it if it does.

Options:
  -r, --remove        Stop and remove the container for this directory
      --recreate,
      --new           Remove the container (if it exists) and create a
                       fresh one
  -h, --help          Show this help message

Arguments:
  command [arg ...]   Command to run in the container (default: /bin/bash)
EOF
}

container_context_fingerprint() {
  (
    cd "$HERE/container"
    find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum
  ) | sha256sum | cut -d ' ' -f 1
}

container_is_stale() {
  local expected_fingerprint="$1"
  local recorded_fingerprint container_image current_image

  recorded_fingerprint="$(podman inspect \
    -f "{{ index .Config.Labels \"$SOURCE_FINGERPRINT_LABEL\" }}" \
    "$NAME" 2>/dev/null || true)"
  container_image="$(podman inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)"
  current_image="$(podman image inspect -f '{{.Id}}' devbox:latest 2>/dev/null || true)"

  if [ "$recorded_fingerprint" = "$expected_fingerprint" ] \
    && [ -n "$current_image" ] \
    && [ "$container_image" = "$current_image" ]; then
    return 1
  fi
  return 0
}

warn_stale_container() {
  echo "==> Existing container '$NAME' is stale or cannot be verified against the current devbox image." >&2
  echo "    Run 'devbox --recreate' to refresh it; the host-backed project directory is preserved." >&2
}

ACTION="run"
COMMAND=()
while [ $# -gt 0 ]; do
  case "$1" in
    -r | --remove)
      ACTION="remove"
      shift
      ;;
    --recreate | --new)
      ACTION="recreate"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      COMMAND=("$@")
      break
      ;;
  esac
done

container_exists() {
  local status
  if podman container exists "$NAME" 2>/dev/null; then
    return 0
  else
    status=$?
  fi
  if [ "$status" -eq 1 ]; then
    return 1
  fi
  echo "==> ERROR: could not determine whether container '$NAME' exists" >&2
  return "$status"
}

remove_container() {
  if container_exists; then
    echo "==> Removing container '$NAME'"
    timeout 30 podman stop "$NAME" >/dev/null 2>&1 || true
    if ! timeout 30 podman rm "$NAME" >/dev/null 2>&1; then
      echo "==> ERROR: failed to remove container '$NAME'" >&2
      return 1
    fi
  else
    local status=$?
    if [ "$status" -ne 1 ]; then
      return "$status"
    fi
    echo "==> Container '$NAME' does not exist; nothing to remove"
  fi
}

acquire_devbox_lock() {
  if [[ -n "$DEVBOX_LOCK_FD" ]]; then
    return 0
  fi
  local lock_root="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/locks"
  local lock_file="$lock_root/devbox-${NAME}.lock"
  local lock_fd
  if ! mkdir -p "$lock_root" || ! chmod 700 "$lock_root" \
    || ! exec {lock_fd}>"$lock_file"; then
    echo "==> Could not create the devbox creation lock '$lock_file'" >&2
    return 1
  fi
  if ! flock "$lock_fd"; then
    echo "==> Could not acquire the devbox creation lock '$lock_file'" >&2
    exec {lock_fd}>&-
    return 1
  fi
  DEVBOX_LOCK_FD="$lock_fd"
}

release_devbox_lock() {
  if [[ -n "$DEVBOX_LOCK_FD" ]]; then
    flock -u "$DEVBOX_LOCK_FD" || true
    exec {DEVBOX_LOCK_FD}>&-
    DEVBOX_LOCK_FD=""
  fi
}

wait_for_docker_api() {
  echo "==> Waiting for nested Podman's Docker-compatible API"
  local api_attempts=0
  local api_deadline=$((SECONDS + 20))
  while ! timeout 3 podman exec "$NAME" curl --connect-timeout 1 --max-time 1 \
    --fail --silent --unix-socket /sandbox/.docker/run/docker.sock \
    http://localhost/_ping >/dev/null 2>&1; do
    api_attempts=$((api_attempts + 1))
    if [ "$api_attempts" -ge 50 ] || [ "$SECONDS" -ge "$api_deadline" ]; then
      echo "==> WARNING: Docker API did not become ready; devbox will continue without it:" >&2
      timeout 10 podman exec "$NAME" devbox-docker-api-check >&2 || true
      return 0
    fi
    sleep 0.1
  done
}

nested_network_sysctl_failure() {
  case "$1" in
    *route_localnet* | *arp_notify* | *rp_filter* | *ip_forward* | \
      *accept_dad* | *accept_ra* | *net.ipv4.conf.default.* | \
      *net.ipv6.conf.default.* | *net.ipv6.conf.all.forwarding* | \
      *net/ipv6/conf/all/forwarding*)
      return 0
      ;;
  esac
  return 1
}

create_container() {
  local lock_acquired=false
  if [[ -z "$DEVBOX_LOCK_FD" ]]; then
    if ! acquire_devbox_lock; then
      return 1
    fi
    lock_acquired=true
  fi

  # A second launcher may have observed the container as absent while the
  # first launcher was creating it. Re-check under the lock before doing any
  # image build or container replacement.
  if container_exists; then
    if [[ "$lock_acquired" == true ]]; then
      release_devbox_lock
    fi
    return 0
  else
    local status=$?
    if [ "$status" -ne 1 ]; then
      if [[ "$lock_acquired" == true ]]; then
        release_devbox_lock
      fi
      return "$status"
    fi
  fi

  local create_status
  if create_container_locked; then
    create_status=0
  else
    create_status=$?
  fi
  if [[ "$lock_acquired" == true ]]; then
    release_devbox_lock
  fi
  return "$create_status"
}

pricetag_openai_models() {
  local base_url="$1"
  local models

  if ! models="$(curl --fail --silent --show-error --location \
    --connect-timeout 5 --max-time 15 \
    -H "Authorization: Bearer ${PRICETAG_API_KEY}" \
    "${base_url%/}/models" | \
    podman run --rm -i "devbox:latest" jq -c \
      '(.data // []) | map(select(.id | type == "string" and length > 0) | {key: .id, value: {name: .id}}) | from_entries')"; then
    echo "==> WARNING: could not discover PriceTag OpenAI models; continuing without a dynamic model catalog" >&2
    printf '{}'
    return 0
  fi

  printf '%s' "$models"
}

pricetag_anthropic_models() {
  local base_url="$1"
  local models

  if ! models="$(curl --fail --silent --show-error --location \
    --connect-timeout 5 --max-time 15 \
    -H "x-api-key: ${PRICETAG_API_KEY}" \
    -H 'anthropic-version: 2023-06-01' \
    "${base_url%/}/models" | \
    podman run --rm -i "devbox:latest" jq -c \
      '(.data // []) | map(select(.id | type == "string" and length > 0) | {key: .id, value: {name: .id}}) | from_entries')"; then
    echo "==> WARNING: could not discover PriceTag Anthropic models; continuing without a dynamic model catalog" >&2
    printf '{}'
    return 0
  fi

  printf '%s' "$models"
}

create_container_locked() {
  local source_fingerprint
  source_fingerprint="$(container_context_fingerprint)"

  podman build \
    --layers \
    --file "$HERE/container/Dockerfile" \
    --tag "devbox:latest" \
    "$HERE/container"

  # Look up the sandbox account's UID/GID from the image instead of
  # hardcoding them, so this keeps working if the base image ever changes
  # them.
  local sandbox_uid sandbox_gid
  sandbox_uid="$(podman run --rm "devbox:latest" id -u sandbox)"
  sandbox_gid="$(podman run --rm "devbox:latest" id -g sandbox)"

  local params=()
  # Each entry is a complete OpenCode config object. They are merged below so
  # every integration can contribute any config item.
  local opencode_config=()

  # Bind-mount the current working directory into the container at /sandbox/<dirname>
  params+=(
    --volume "$BIND_DIR:$WORKDIR" \
  )

  # Persistent storage shared across *all* devbox instances (not just this
  # directory's container):
  #   - The knowledge base and uv/pre-commit caches use Podman-managed named
  #     volumes: their host-side location doesn't matter, and rootless Podman
  #     gives them the same keep-id-aware ownership handling as the bind mounts
  #     above.
  #   - Nested Podman/Buildah's own image and layer storage
  #     (/sandbox/.local/share/containers/storage, per storage.conf's
  #     default graphroot) instead uses a host-backed directory, so its
  #     size can be inspected and pruned with ordinary host tools (`du`,
  #     `rm -rf`) without needing `podman volume` commands.
  local podman_storage_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/containers-storage"
  mkdir -p "$podman_storage_cache_dir"
  params+=(
    --volume "devbox-kb:/sandbox/kb" \
    --volume "devbox-uv-cache:/sandbox/.uv_cache" \
    --volume "devbox-precommit-cache:/sandbox/.cache/pre-commit" \
    --volume "$podman_storage_cache_dir:/sandbox/.local/share/containers/storage" \
  )

  # Allow access to /tmp and /sandbox w/o prompting
  opencode_config+=(
    "$(cat <<'EOF'
{
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/sandbox/**": "allow",
      "/sandbox/.cache/pre-commit/**": "allow",
      "/sandbox/.*": "ask"
    }
  }
}
EOF
)"
  )

  # Atlassian CLI (acli) configuration
  if [ -d "$HOME/.config/acli" ]; then
    params+=(
      --volume "$HOME/.config/acli:/sandbox/.config/acli" \
    )
  fi

  # Make the user's global skills available inside the devbox when present.
  if [ -d "$HOME/.agents" ]; then
    params+=(
      --volume "$HOME/.agents:/sandbox/.agents" \
    )
  fi

  # Gemini API
  if [ -n "${GEMINI_API_KEY:-}" ]; then
    params+=(
      --env "GEMINI_API_KEY=${GEMINI_API_KEY:-}" \
      --env "GOOGLE_GENERATIVE_AI_API_KEY=${GEMINI_API_KEY:-}" \
    )
  fi

  # GitHub CLI (gh) configuration and OpenCode GitHub MCP integration
  local github_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [ -z "$github_token" ] && command -v gh >/dev/null 2>&1; then
    github_token="$(gh auth token 2>/dev/null || true)"
  fi
  if [ -n "$github_token" ]; then
    params+=(
      --env "GH_TOKEN=$github_token" \
      --env "GITHUB_TOKEN=$github_token" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "devbox-github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}"
      }
    }
  }
}
EOF
)"
    )
  fi

  # Context7 MCP integration
  if [ -n "${CONTEXT7_API_KEY:-}" ]; then
    params+=(
      --env "CONTEXT7_API_KEY=${CONTEXT7_API_KEY:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
EOF
)"
    )
  fi

  # The Source MCP integration
  if [ -n "${IGLOO_MCP_COMMUNITY:-}" ] \
    && [ -n "${IGLOO_MCP_COMMUNITY_KEY:-}" ] \
    && [ -n "${IGLOO_MCP_APP_PASS:-}" ] \
    && [ -n "${IGLOO_MCP_APP_ID:-}" ] \
    && [ -n "${IGLOO_MCP_USERNAME:-}" ] \
    && [ -n "${IGLOO_MCP_PASSWORD:-}" ]; then
    params+=(
      --env "IGLOO_MCP_COMMUNITY=${IGLOO_MCP_COMMUNITY:-}" \
      --env "IGLOO_MCP_COMMUNITY_KEY=${IGLOO_MCP_COMMUNITY_KEY:-}" \
      --env "IGLOO_MCP_APP_PASS=${IGLOO_MCP_APP_PASS:-}" \
      --env "IGLOO_MCP_APP_ID=${IGLOO_MCP_APP_ID:-}" \
      --env "IGLOO_MCP_USERNAME=${IGLOO_MCP_USERNAME:-}" \
      --env "IGLOO_MCP_PASSWORD=${IGLOO_MCP_PASSWORD:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "the-source": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/johnstrunk/igloo-mcp",
        "igloo-mcp"
      ],
      "environment": {
        "IGLOO_MCP_COMMUNITY": "{env:IGLOO_MCP_COMMUNITY}",
        "IGLOO_MCP_COMMUNITY_KEY": "{env:IGLOO_MCP_COMMUNITY_KEY}",
        "IGLOO_MCP_APP_PASS": "{env:IGLOO_MCP_APP_PASS}",
        "IGLOO_MCP_APP_ID": "{env:IGLOO_MCP_APP_ID}",
        "IGLOO_MCP_USERNAME": "{env:IGLOO_MCP_USERNAME}",
        "IGLOO_MCP_PASSWORD": "{env:IGLOO_MCP_PASSWORD}",
        "IGLOO_MCP_SERVER_NAME": "The Source",
        "IGLOO_MCP_SERVER_INSTRUCTIONS": "This server provides search and fetch capabilities for The Source, Red Hat's intranet, containing articles with guides, instructions, and useful information that helps team members do their jobs and contribute to Red Hat."
      }
    }
  }
}
EOF
)"
    )
  fi

  # GitLab CLI (glab) configuration
  if [ -n "${GITLAB_TOKEN:-}" ]; then
    params+=(
      --env "GITLAB_HOST=${GITLAB_HOST:-gitlab.com}" \
      --env "GITLAB_TOKEN=${GITLAB_TOKEN:-}" \
    )
  fi

  # Google Workspace CLI (gws) configuration
  if [ -d "$HOME/.config/gws" ]; then
    params+=(
      --volume "$HOME/.config/gws:/sandbox/.config/gws" \
    )
  fi

  # LiteMaaS configuration
  if [ -n "${LITEMAAS_API_KEY:-}" ]; then
    params+=(
      --env "LITEMAAS_API_KEY=${LITEMAAS_API_KEY:-}" \
    )
  fi

  # OpenAI configuration
  if [ -n "${OPENAI_API_KEY:-}" ]; then
    params+=(
      --env "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
    )
  fi

  # Anthropic configuration
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    params+=(
      --env "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
    )
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    params+=(
      --env "ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}" \
    )
  fi

  # Configure optional custom Pricetag providers. The shared API key is
  # required for either interface, but each interface has its own endpoint.
  local pricetag_enabled=false
  local pricetag_anthropic_models='{}'
  local pricetag_openai_models='{}'
  if [ -n "${PRICETAG_API_KEY:-}" ]; then
    if [ -n "${PRICETAG_ANTHROPIC_URL:-}" ]; then
      pricetag_enabled=true
      pricetag_anthropic_models="$(pricetag_anthropic_models "$PRICETAG_ANTHROPIC_URL")"
      params+=(
        --env "PRICETAG_ANTHROPIC_URL=${PRICETAG_ANTHROPIC_URL:-}" \
      )
      opencode_config+=(
        "$(cat <<EOF
{
  "provider": {
    "pricetag-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "PriceTag (Anthropic)",
      "options": {
        "baseURL": "{env:PRICETAG_ANTHROPIC_URL}",
        "apiKey": "{env:PRICETAG_API_KEY}"
      },
      "models": $pricetag_anthropic_models
    }
  }
}
EOF
)"
      )
    fi

    if [ -n "${PRICETAG_OPENAI_URL:-}" ]; then
      pricetag_enabled=true
      pricetag_openai_models="$(pricetag_openai_models "$PRICETAG_OPENAI_URL")"
      params+=(
        --env "PRICETAG_OPENAI_URL=${PRICETAG_OPENAI_URL:-}" \
      )
      opencode_config+=(
        "$(cat <<EOF
{
  "provider": {
    "pricetag-openai": {
      "npm": "@ai-sdk/openai",
      "name": "PriceTag (OpenAI)",
      "options": {
        "baseURL": "{env:PRICETAG_OPENAI_URL}",
        "apiKey": "{env:PRICETAG_API_KEY}"
      },
      "models": $pricetag_openai_models
    }
  }
}
EOF
)"
      )
    fi

    if [ "$pricetag_enabled" = true ]; then
      params+=(
        --env "PRICETAG_API_KEY=${PRICETAG_API_KEY:-}" \
      )
    fi
  fi

  # OpenCode session data and configuration
  if [ -d "$HOME/.local/share/opencode" ]; then
    params+=(
      --volume "$HOME/.local/share/opencode:/sandbox/.local/share/opencode" \
    )
  fi
  if [ -d "$HOME/.config/opencode" ]; then
    params+=(
      --volume "$HOME/.config/opencode:/sandbox/.config/opencode" \
    )
  fi
  if [ -d "$HOME/.local/state/opencode" ]; then
    params+=(
      --volume "$HOME/.local/state/opencode:/sandbox/.local/state/opencode" \
    )
  elif [ -f "$HOME/.local/state/opencode/model.json" ]; then
    params+=(
      --volume "$HOME/.local/state/opencode/model.json:/sandbox/.local/state/opencode/model.json" \
    )
  fi
  if [ -f "$HERE/opencode.json" ]; then
    params+=(
      --volume "$HERE/opencode.json:/sandbox/opencode.json" \
    )
  fi

  # Vertex AI configuration
  if [ -n "${GOOGLE_CLOUD_PROJECT:-}" ] && [ -n "${VERTEX_LOCATION:-}" ]; then
    params+=(
      --env "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}" \
      --env "VERTEX_LOCATION=${VERTEX_LOCATION:-global}" \
    )
  fi
  if [ -f "$HOME/.config/gcloud/application_default_credentials.json" ]; then
    params+=(
      --volume "$HOME/.config/gcloud/application_default_credentials.json:/sandbox/.config/gcloud/application_default_credentials.json" \
    )
  fi

  if [ "${#opencode_config[@]}" -gt 0 ]; then
    local opencode_config_content
    opencode_config_content="$({
      printf '%s\n' "{\"\$schema\":\"https://opencode.ai/config.json\"}"
      printf '%s\n' "${opencode_config[@]}"
    } | podman run --rm -i "devbox:latest" jq -s -c \
      "reduce .[] as \$item ({}; . * \$item)")"
    params+=(
      --env "OPENCODE_CONFIG_CONTENT=$opencode_config_content" \
    )
  fi

  local base_run_args=(
    run -d
    --user sandbox
    --userns "keep-id:uid=$sandbox_uid,gid=$sandbox_gid"
    --name "$NAME"
    --label "$SOURCE_FINGERPRINT_LABEL=$source_fingerprint"
    --stop-timeout 0
    --device /dev/fuse
    --device /dev/net/tun
    --security-opt label=disable
    --env "DEVBOX_SUBID_READY_FILE=$SUBID_READY_FILE"
  )
  # Nested Podman's Docker-compatible API defaults new containers to the
  # pasta network (see container/Dockerfile), which already supports
  # published ports without any of this. An *explicit* netavark bridge
  # network (`podman network create`, or Testcontainers' Network class)
  # still needs nested netavark to write a few net.ipv4 sysctls for the
  # bridge interface it creates, which fails through this outer container's
  # own read-only /proc/sys unless those values are already correct. A
  # fresh network namespace that a nested process creates inherits this
  # outer container's current net.ipv4.conf.default.* values, so preseeding
  # them here -- if the host running this `podman run` allows it -- can let
  # nested netavark's own read-before-write skip straight past the write
  # that would otherwise fail. See container/Dockerfile for the sysctl
  # names netavark's bridge setup writes and why this specific set covers
  # them.
  local nested_bridge_sysctls=(
    --sysctl net.ipv4.conf.default.route_localnet=1
    --sysctl net.ipv4.conf.default.arp_notify=1
    --sysctl net.ipv4.conf.default.rp_filter=2
    --sysctl net.ipv4.ip_forward=1
    --sysctl net.ipv6.conf.default.accept_dad=0
    --sysctl net.ipv6.conf.default.accept_ra=0
    --sysctl net.ipv6.conf.all.forwarding=1
  )
  local nested_bridge_networks_enabled=false
  local nested_network_preflight_image="${DEVBOX_NESTED_NETWORK_PREFLIGHT_IMAGE:-docker.io/library/alpine:3.22}"

  cleanup_failed_create() {
    echo "==> Removing incomplete container '$NAME'" >&2
    if ! timeout 10 podman rm -f "$NAME" >/dev/null 2>&1; then
      echo "==> WARNING: could not remove incomplete container '$NAME'" >&2
    fi
  }
  trap 'cleanup_failed_create; exit 130' INT TERM

  echo "==> Creating container '$NAME'"
  local run_output
  if run_output="$(
    podman "${base_run_args[@]}" "${nested_bridge_sysctls[@]}" \
      "${params[@]}" "devbox:latest" 2>&1
  )"; then
    printf '%s\n' "$run_output"
    nested_bridge_networks_enabled=true
  elif nested_network_sysctl_failure "$run_output"; then
    echo "==> Outer Podman rejected the nested-bridge-network sysctls; retrying without them" >&2
    printf '%s\n' "$run_output" >&2
    cleanup_failed_create
    if ! run_output="$(podman "${base_run_args[@]}" "${params[@]}" "devbox:latest" 2>&1)"; then
      printf '%s\n' "$run_output" >&2
      cleanup_failed_create
      trap - INT TERM
      return 1
    fi
    printf '%s\n' "$run_output"
    echo "==> Nested Podman will use its pasta default network only; user-defined bridge networks (e.g. Testcontainers Network aliases) won't be available. Published ports still work -- see 'devbox-docker-api-check'." >&2
  else
    printf '%s\n' "$run_output" >&2
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi

  # --userns=keep-id gives this container's own user namespace a limited
  # range of usable IDs (0..N, where N is determined by the invoking host
  # user's own /etc/subuid/subgid allocation -- it can't be known at image
  # build time). Nested Podman's subordinate ID delegation (/etc/subuid,
  # /etc/subgid, consumed by its own newuidmap/newgidmap when it builds a
  # user namespace for the containers *it* runs) must fit entirely within
  # that range: per user_namespaces(7), "the mapped user IDs must in turn
  # have a mapping in the parent user namespace." A range outside it (e.g.
  # a fixed build-time guess) makes nested `podman run` fail with
  # "newuidmap: write to uid_map failed: Operation not permitted".
  #
  # Compute the actual available range from the running container's own
  # uid_map/gid_map, and split the delegation into the two chunks before
  # and after sandbox's own ID (skipping it, and skipping ID 0 -- mapping a
  # nested ID to the parent's UID/GID 0 additionally requires CAP_SETFCAP,
  # which sandbox doesn't have; see user_namespaces(7)) to make full use of
  # the available range. This mirrors podman's own reference image, whose
  # /etc/subuid delegates "podman:1:999" plus "podman:1001:64535" around
  # its "podman" user's identity of 1000:
  # https://github.com/containers/podman/blob/main/contrib/podmanimage/stable/Dockerfile
  echo "==> Configuring nested Podman's subordinate UID/GID delegation"
  local max_uid max_gid
  # shellcheck disable=SC2016
  if ! max_uid="$(timeout 30 podman exec "$NAME" awk '{ if ($1 + $3 - 1 > max) max = $1 + $3 - 1 } END { print max }' /proc/self/uid_map)"; then
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi
  # shellcheck disable=SC2016
  if ! max_gid="$(timeout 30 podman exec "$NAME" awk '{ if ($1 + $3 - 1 > max) max = $1 + $3 - 1 } END { print max }' /proc/self/gid_map)"; then
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi
  if [[ ! "$max_uid" =~ ^[0-9]+$ || ! "$max_gid" =~ ^[0-9]+$ ]] \
    || [ "$max_uid" -le "$sandbox_uid" ] \
    || [ "$max_gid" -le "$sandbox_gid" ]; then
    echo "==> Nested Podman reported invalid subordinate-ID bounds" >&2
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi
  subid_ranges() { # id max -> "sandbox:..." subuid/subgid lines around $id
    local id="$1" max="$2"
    if [ "$id" -gt 1 ]; then
      echo "sandbox:1:$((id - 1))"
    fi
    if [ "$max" -gt "$id" ]; then
      echo "sandbox:$((id + 1)):$((max - id))"
    fi
  }
  if ! timeout 30 podman exec -u 0:0 "$NAME" sed -i '/^sandbox:/d' /etc/subuid /etc/subgid; then
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi
  if ! subid_ranges "$sandbox_uid" "$max_uid" \
    | timeout 30 podman exec -i -u 0:0 "$NAME" tee -a /etc/subuid >/dev/null; then
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi
  if ! subid_ranges "$sandbox_gid" "$max_gid" \
    | timeout 30 podman exec -i -u 0:0 "$NAME" tee -a /etc/subgid >/dev/null; then
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi

  # Podman auto-creates missing parent directories for bind-mounted
  # files/dirs (e.g. the opencode model.json mount above) as root, ignoring
  # --userns=keep-id's UID mapping for the container's "sandbox" user. Fix
  # up any such root-owned directories under /sandbox, without recursing
  # into the actual bind-mounted content (-xdev stops at the mount
  # boundary, so this only touches the container's own filesystem, never
  # files on the host).
  echo "==> Fixing ownership of any root-owned bind-mount parent directories"
  timeout 30 podman exec -u 0:0 "$NAME" \
    find /sandbox -xdev \( ! -uid "$sandbox_uid" -o ! -gid "$sandbox_gid" \) \
    -exec chown -h "$sandbox_uid:$sandbox_gid" {} + 2>/dev/null || true

  if [[ "$nested_bridge_networks_enabled" == true ]]; then
    echo "==> Verifying nested rootless-network sysctls"
    # shellcheck disable=SC2016
    if ! timeout 30 podman exec "$NAME" podman unshare --rootless-netns sh -c '
      set -eu
      for requirement in \
        net/ipv4/conf/default/route_localnet=1 \
        net/ipv4/conf/default/arp_notify=1 \
        net/ipv4/conf/default/rp_filter=2 \
        net/ipv4/ip_forward=1 \
        net/ipv6/conf/default/accept_dad=0 \
        net/ipv6/conf/default/accept_ra=0 \
        net/ipv6/conf/all/forwarding=1; do
        path="/proc/sys/${requirement%%=*}"
        expected="${requirement#*=}"
        actual="$(tr -d "[:space:]" < "$path")"
        if [ "$actual" != "$expected" ]; then
          printf "%s is %s (want %s)\\n" "$path" "$actual" "$expected" >&2
          exit 1
        fi
      done
    '; then
      echo "==> Nested rootless-network sysctls are not usable; keeping pasta-only API networking" >&2
      nested_bridge_networks_enabled=false
    fi
  fi

  if [[ "$nested_bridge_networks_enabled" == true ]]; then
    echo "==> Probing nested user-defined netavark network and published-port support"
    local preflight_network="devbox-api-preflight-$$"
    local preflight_container_id=""
    local preflight_failed=false
    if ! timeout 30 podman exec "$NAME" podman network create \
      "$preflight_network" >/dev/null; then
      preflight_failed=true
    else
      if ! preflight_container_id="$(timeout 30 podman exec "$NAME" podman create \
        --network "$preflight_network" --publish :80 \
        "$nested_network_preflight_image" true)" \
        || [[ -z "$preflight_container_id" ]]; then
        preflight_failed=true
      elif ! timeout 120 podman exec "$NAME" podman start --attach \
        "$preflight_container_id"; then
        preflight_failed=true
      fi
      if [[ -n "$preflight_container_id" ]]; then
        local preflight_container_removed=false
        for _ in {1..3}; do
          if timeout 5 podman exec "$NAME" podman rm -f \
            "$preflight_container_id" >/dev/null 2>&1; then
            preflight_container_removed=true
            break
          fi
          sleep 0.2
        done
        if [[ "$preflight_container_removed" == false ]]; then
          echo "==> WARNING: could not remove the nested network preflight container" >&2
          preflight_failed=true
        fi
      fi
      local preflight_network_removed=false
      for _ in {1..3}; do
        if timeout 5 podman exec "$NAME" podman network rm \
          "$preflight_network" >/dev/null; then
          preflight_network_removed=true
          break
        fi
        sleep 0.2
      done
      if [[ "$preflight_network_removed" == false ]]; then
        echo "==> WARNING: could not remove the nested network preflight network" >&2
        preflight_failed=true
      fi
    fi
    if [[ "$preflight_failed" == true ]]; then
      echo "==> Nested netavark bridge probing failed; keeping pasta-only API networking" >&2
      nested_bridge_networks_enabled=false
    fi
  fi

  if [[ "$nested_bridge_networks_enabled" == true ]]; then
    echo "==> Enabling nested netavark bridge mode for Docker API network aliases"
    if ! timeout 30 podman exec -u 0:0 "$NAME" sed -i \
      's/^netns = "pasta"$/netns = "bridge"/' \
      /sandbox/.config/containers/containers.conf; then
      cleanup_failed_create
      trap - INT TERM
      return 1
    fi
  fi

  # Git identity: a fresh sandbox account has no Git identity configured,
  # so an uninformed `git commit` inside the container fails with Git's
  # "empty ident name" error. Fill in only whatever is missing, using the
  # *invoking host user's* `git config --global user.name`/`user.email`
  # as the source of truth -- never data baked into the image, and this
  # never reads or writes the host's Git config beyond that lookup. Any
  # identity already configured inside this (persistent) container is
  # left untouched.
  echo "==> Configuring Git identity"
  local existing_git_name existing_git_email
  existing_git_name="$(podman exec "$NAME" git config --global user.name 2>/dev/null || true)"
  existing_git_email="$(podman exec "$NAME" git config --global user.email 2>/dev/null || true)"

  if [ -z "$existing_git_name" ]; then
    local host_git_name
    host_git_name="$(git config --global user.name 2>/dev/null || true)"
    if [ -n "$host_git_name" ]; then
      if podman exec "$NAME" git config --global user.name "$host_git_name"; then
        existing_git_name="$host_git_name"
      else
        echo "    WARNING: Failed to set Git user.name inside the container." >&2
      fi
    fi
  fi
  if [ -z "$existing_git_email" ]; then
    local host_git_email
    host_git_email="$(git config --global user.email 2>/dev/null || true)"
    if [ -n "$host_git_email" ]; then
      if podman exec "$NAME" git config --global user.email "$host_git_email"; then
        existing_git_email="$host_git_email"
      else
        echo "    WARNING: Failed to set Git user.email inside the container." >&2
      fi
    fi
  fi

  if [ -z "$existing_git_name" ] || [ -z "$existing_git_email" ]; then
    echo "    WARNING: Git user.name and/or user.email are not configured (checked the container and the host)." >&2
    echo "    Commits inside the devbox will fail until you run, inside the container:" >&2
    echo '      git config --global user.name "Your Name"' >&2
    echo '      git config --global user.email "you@example.com"' >&2
    echo "    Or run 'git config --global user.name/user.email' on the host before starting devbox." >&2
  fi

  # GitHub authentication: the devbox has no usable SSH access to GitHub,
  # so Git operations over HTTPS against github.com must authenticate via
  # the `gh` CLI's credential helper rather than SSH keys or an agent.
  # `gh auth setup-git` reads whichever credentials `gh` already has (e.g.
  # the GH_TOKEN/GITHUB_TOKEN env var set above) each time Git needs them,
  # so this only needs to register the helper once per container.
  if [ -n "$github_token" ]; then
    echo "==> Configuring gh as Git's credential helper for GitHub HTTPS operations"
    if ! podman exec "$NAME" gh auth setup-git; then
      echo "    WARNING: 'gh auth setup-git' failed; Git HTTPS operations against github.com may fail or prompt for credentials." >&2
    fi
  else
    echo "    WARNING: No GitHub token available; Git HTTPS operations against github.com will fail until you run, inside the container:" >&2
    echo "      gh auth login && gh auth setup-git" >&2
    echo "    Or set GH_TOKEN/GITHUB_TOKEN, or log in with 'gh auth login' on the host, before starting devbox." >&2
  fi
  # The entrypoint waits for this marker before starting the API service so
  # Podman sees the dynamically computed subordinate-ID ranges above.
  if ! timeout 30 podman exec -u 0:0 "$NAME" touch "$SUBID_READY_FILE"; then
    echo "==> Failed to signal nested Podman that subordinate IDs are ready" >&2
    cleanup_failed_create
    trap - INT TERM
    return 1
  fi

  trap - INT TERM
}

enter_container() {
  if ! acquire_devbox_lock; then
    return 1
  fi

  local enter_status
  if [ "$(podman inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
    if container_exists; then
      echo "==> Starting container '$NAME'"
      if timeout 30 podman start "$NAME" >/dev/null; then
        :
      else
        enter_status=$?
        release_devbox_lock
        return "$enter_status"
      fi
    else
      enter_status=$?
      if [ "$enter_status" -ne 1 ]; then
        release_devbox_lock
        return "$enter_status"
      fi
      echo "==> Container '$NAME' disappeared before it could be entered; creating it" >&2
      if create_container_locked; then
        enter_status=0
      else
        enter_status=$?
        release_devbox_lock
        return "$enter_status"
      fi
    fi
  fi
  if wait_for_docker_api; then
    :
  else
    enter_status=$?
    release_devbox_lock
    return "$enter_status"
  fi
  release_devbox_lock
  echo "==> Entering container '$NAME'"
  local exec_opts=("-i")
  if [ -t 0 ] && [ -t 1 ]; then
    exec_opts+=("-t")
  fi
  if [ $# -eq 0 ]; then
    exec podman exec "${exec_opts[@]}" -w "$WORKDIR" "$NAME" /bin/bash
  else
    exec podman exec "${exec_opts[@]}" -w "$WORKDIR" "$NAME" "$@"
  fi
}

case "$ACTION" in
  remove)
    if ! acquire_devbox_lock; then
      exit 1
    fi
    if remove_container; then
      enter_status=0
    else
      enter_status=$?
    fi
    release_devbox_lock
    exit "$enter_status"
    ;;
  recreate)
    if ! acquire_devbox_lock; then
      exit 1
    fi
    if remove_container; then
      if create_container; then
        enter_status=0
      else
        enter_status=$?
      fi
    else
      enter_status=$?
    fi
    if [ "$enter_status" -ne 0 ]; then
      release_devbox_lock
      exit "$enter_status"
    fi
    enter_container "${COMMAND[@]}"
    ;;
  run)
    if container_exists; then
      expected_source_fingerprint="$(container_context_fingerprint)"
      if container_is_stale "$expected_source_fingerprint"; then
        warn_stale_container
      fi
    else
      enter_status=$?
      if [ "$enter_status" -ne 1 ]; then
        exit "$enter_status"
      fi
      create_container
    fi
    enter_container "${COMMAND[@]}"
    ;;
esac
