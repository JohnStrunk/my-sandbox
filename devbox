#!/usr/bin/env bash
# VM-only entry point for the shared Lima devbox.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Clear XDG_DATA_HOME so `devbox` works inside vscode terminal sessions.
export XDG_DATA_HOME=

usage() {
  cat <<EOF
Usage: $(basename "$0") [--stop|--reset|--reprovision] [-h|--help] [--] [command [arg ...]]

Open a shell or run a command in the shared Lima VM at the current project
directory. On first use, the VM is created from this checkout's Lima template.

Options:
      --stop          Gracefully stop the shared Lima VM
      --reset         Factory-reset and reprovision the Lima VM
      --reprovision   Restart the Lima VM and rerun provisioning
  -h, --help          Show this help message

Arguments:
  command [arg ...]   Command to run in the VM (default: shell)
EOF
}

action=run
command=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --stop)
      action=stop
      shift
      ;;
    --reset)
      action=reset
      shift
      ;;
    --reprovision)
      action=reprovision
      shift
      ;;
    --container)
      echo "devbox: --container is no longer supported; devbox uses the shared Lima VM" >&2
      exit 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      command=("$@")
      break
      ;;
    -* )
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      command=("$@")
      break
      ;;
  esac
done

exec "$HERE/lima/devbox" "$action" "${command[@]}"
