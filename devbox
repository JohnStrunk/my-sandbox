#!/usr/bin/env bash
# Single-command launcher: OpenShell replacement for devcontainer launch.
#
# Runs as a fully rootless Podman container: the main process keeps the
# image's built-in "sandbox" account (via `--userns=keep-id`), so files
# created in the container land on the host owned by the invoking user,
# with no runtime UID/GID remapping or ownership fix-up required. The image
# also bundles a rootless, nested Podman (Podman-in-Podman) so the sandbox
# can build/run its own containers without the outer container needing
# --privileged or any added Linux capabilities.
#
# Bind-mounts the *current working directory* into a per-directory
# container (named "devbox-<dirname>"). This is meant to be symlinked onto
# $PATH (e.g. `ln -s /path/to/this/repo/devbox ~/bin/devbox`), so a user can
# simply `cd` into whatever project they want to work on and run `devbox`:
#   - If the container for that directory doesn't already exist, it's
#     created (building the image first, if needed) with the current
#     directory bind-mounted in.
#   - If it already exists, this just execs a shell or the provided command
#     into it (starting it first if it's currently stopped).
set -euo pipefail

LAUNCHER_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$LAUNCHER_SCRIPT")" && pwd)"
BIND_DIR="$(realpath "$PWD")"
NAME="devbox-$(basename "$BIND_DIR")"
WORKDIR="/sandbox/$(basename "$BIND_DIR")"
SOURCE_FINGERPRINT_LABEL="io.github.johnstrunk.my-sandbox.devbox-context-fingerprint"
SUBID_READY_FILE="/sandbox/.devbox-subids-ready"
DEVBOX_LOCK_FD=""
PODMAN_RUNTIME_LOCK_FD=""
DEVBOX_IMAGE_TAG="devbox:latest"

# Clear XDG_DATA_HOME so `devbox` works inside vscode terminal sessions
export XDG_DATA_HOME=

usage() {
  cat <<EOF
Usage: $(basename "$0") [-r|--remove] [--recreate|--new] [-h|--help] [--] [command [arg ...]]

Bind-mounts the current directory ($BIND_DIR) into a devbox container
named '$NAME': creating it if it doesn't exist, or exec'ing a command/shell
into it if it does.

Options:
  -r, --remove        Stop and remove the container for this directory
      --recreate,
      --new           Remove the container (if it exists) and create a
                       fresh one
  -h, --help          Show this help message

Arguments:
  command [arg ...]   Command to run in the container (default: /bin/bash)
EOF
}

container_context_fingerprint() {
  local mode path
  # Covers the container build context *and* the launcher itself: bind
  # mounts, injected env, and exec contracts live in this script, so a
  # container built by an older launcher must be reported stale (issue
  # #179). Hashing stdin keeps the value independent of where the repo
  # is checked out. Preserve metadata that can change COPY results too:
  # executable bits, directory entries, and symlink targets are all part of
  # the effective build context.
  {
    (
      cd "$HERE/container"
      find . -mindepth 1 -print0 | LC_ALL=C sort -z |
        while IFS= read -r -d '' path; do
          mode="$(stat -c '%a' -- "$path")"
          if [ -L "$path" ]; then
            printf 'symlink\0%s\0%s\0' "$mode" "$path"
            readlink --zero -- "$path"
          elif [ -d "$path" ]; then
            printf 'directory\0%s\0%s\0' "$mode" "$path"
          elif [ -f "$path" ]; then
            printf 'file\0%s\0%s\0' "$mode" "$path"
            sha256sum < "$path" | cut -d ' ' -f 1
            printf '\0'
          else
            printf '%s\0%s\0%s\0' "$(stat -c '%F' -- "$path")" "$mode" "$path"
          fi
        done
    )
    printf 'launcher mode=%s hash=%s\n' \
      "$(stat -c '%a' -- "$LAUNCHER_SCRIPT")" \
      "$(sha256sum < "$LAUNCHER_SCRIPT" | cut -d ' ' -f 1)"
  } | sha256sum | cut -d ' ' -f 1
}

devbox_development_checkout() {
  local repository_root
  repository_root="$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$repository_root" ] || return 1

  case "$BIND_DIR/" in
    "$repository_root/"*) return 0 ;;
  esac
  return 1
}

devbox_context_image_tag() {
  printf 'localhost/devbox:context-%s' "$1"
}

devbox_runtime_image_tag() {
  local fingerprint="$1"
  if devbox_development_checkout; then
    devbox_context_image_tag "$fingerprint"
  else
    printf 'devbox:latest'
  fi
}

container_is_stale() {
  local expected_fingerprint="$1"
  local image_tag="$2"
  local recorded_fingerprint container_image current_image

  recorded_fingerprint="$(podman inspect \
    -f "{{ index .Config.Labels \"$SOURCE_FINGERPRINT_LABEL\" }}" \
    "$NAME" 2>/dev/null || true)"
  container_image="$(podman inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)"
  current_image="$(podman image inspect -f '{{.Id}}' "$image_tag" 2>/dev/null || true)"

  if [ "$recorded_fingerprint" = "$expected_fingerprint" ] \
    && [ -n "$current_image" ] \
    && [ "$container_image" = "$current_image" ]; then
    return 1
  fi
  return 0
}

warn_stale_container() {
  echo "==> Existing container '$NAME' is stale or cannot be verified against the current devbox image." >&2
  echo "    Run 'devbox --recreate' to refresh it; the host-backed project directory is preserved." >&2
}

ACTION="run"
COMMAND=()
while [ $# -gt 0 ]; do
  case "$1" in
    -r | --remove)
      ACTION="remove"
      shift
      ;;
    --recreate | --new)
      ACTION="recreate"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      COMMAND=("$@")
      break
      ;;
  esac
done

container_exists() {
  local status
  if podman container exists "$NAME" 2>/dev/null; then
    return 0
  else
    status=$?
  fi
  if [ "$status" -eq 1 ]; then
    return 1
  fi
  echo "==> ERROR: could not determine whether container '$NAME' exists" >&2
  return "$status"
}

remove_container() {
  if container_exists; then
    echo "==> Removing container '$NAME'"
    timeout 30 podman stop "$NAME" >/dev/null 2>&1 || true
    if ! timeout 30 podman rm "$NAME" >/dev/null 2>&1; then
      echo "==> ERROR: failed to remove container '$NAME'" >&2
      return 1
    fi
  else
    local status=$?
    if [ "$status" -ne 1 ]; then
      return "$status"
    fi
    echo "==> Container '$NAME' does not exist; nothing to remove"
  fi
}

acquire_devbox_lock() {
  if [[ -n "$DEVBOX_LOCK_FD" ]]; then
    return 0
  fi
  # Always take the shared runtime lock first; sanitized test runs hold it
  # while launching devbox children, so the order prevents cross-worktree
  # deadlocks on a per-container lock.
  local runtime_lock_acquired=false
  if [[ -z "$PODMAN_RUNTIME_LOCK_FD" \
    && "${MY_SANDBOX_PODMAN_RUNTIME_LOCK_HELD:-}" != "1" ]]; then
    if ! acquire_podman_runtime_lock; then
      return 1
    fi
    runtime_lock_acquired=true
  fi

  local lock_root="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/locks"
  local lock_file="$lock_root/devbox-${NAME}.lock"
  local lock_fd
  if ! mkdir -p "$lock_root" || ! chmod 700 "$lock_root" \
    || ! exec {lock_fd}>"$lock_file"; then
    echo "==> Could not create the devbox creation lock '$lock_file'" >&2
    if [[ "$runtime_lock_acquired" == true ]]; then
      release_podman_runtime_lock
    fi
    return 1
  fi
  if ! flock "$lock_fd"; then
    echo "==> Could not acquire the devbox creation lock '$lock_file'" >&2
    exec {lock_fd}>&-
    if [[ "$runtime_lock_acquired" == true ]]; then
      release_podman_runtime_lock
    fi
    return 1
  fi
  DEVBOX_LOCK_FD="$lock_fd"
}

release_devbox_lock() {
  if [[ -n "$DEVBOX_LOCK_FD" ]]; then
    flock -u "$DEVBOX_LOCK_FD" || true
    exec {DEVBOX_LOCK_FD}>&-
    DEVBOX_LOCK_FD=""
  fi
  release_podman_runtime_lock
}

acquire_podman_runtime_lock() {
  # Container-enabled test runs hold this lock for the duration of their
  # shared-storage work and pass the marker through to launcher subprocesses.
  # Avoid trying to acquire the same flock again from those children.
  if [[ "${MY_SANDBOX_PODMAN_RUNTIME_LOCK_HELD:-}" == "1" ]]; then
    return 0
  fi
  if [[ -n "$PODMAN_RUNTIME_LOCK_FD" ]]; then
    return 0
  fi

  local lock_file="${MY_SANDBOX_PODMAN_RUNTIME_LOCK_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/devbox/locks/podman-runtime.lock}"
  local lock_root="${lock_file%/*}"
  local lock_fd
  if ! mkdir -p "$lock_root" || ! chmod 700 "$lock_root" \
    || ! exec {lock_fd}>"$lock_file"; then
    echo "==> Could not create the shared Podman runtime lock '$lock_file'" >&2
    return 1
  fi
  if ! chmod 600 "$lock_file"; then
    echo "==> Could not secure the shared Podman runtime lock '$lock_file'" >&2
    exec {lock_fd}>&-
    return 1
  fi
  if ! flock "$lock_fd"; then
    echo "==> Could not acquire the shared Podman runtime lock '$lock_file'" >&2
    exec {lock_fd}>&-
    return 1
  fi
  PODMAN_RUNTIME_LOCK_FD="$lock_fd"
}

release_podman_runtime_lock() {
  if [[ -n "$PODMAN_RUNTIME_LOCK_FD" ]]; then
    flock -u "$PODMAN_RUNTIME_LOCK_FD" || true
    exec {PODMAN_RUNTIME_LOCK_FD}>&-
    PODMAN_RUNTIME_LOCK_FD=""
  fi
}

wait_for_docker_api() {
  echo "==> Waiting for nested Podman's Docker-compatible API"
  local api_attempts=0
  local api_deadline=$((SECONDS + 20))
  while ! timeout 3 podman exec "$NAME" curl --connect-timeout 1 --max-time 1 \
    --fail --silent --unix-socket /sandbox/.docker/run/docker.sock \
    http://localhost/_ping >/dev/null 2>&1; do
    api_attempts=$((api_attempts + 1))
    if [ "$api_attempts" -ge 50 ] || [ "$SECONDS" -ge "$api_deadline" ]; then
      echo "==> WARNING: Docker API did not become ready; devbox will continue without it:" >&2
      timeout 10 podman exec "$NAME" devbox-docker-api-check >&2 || true
      return 0
    fi
    sleep 0.1
  done
}

nested_network_sysctl_failure() {
  case "$1" in
    *route_localnet* | *arp_notify* | *rp_filter* | *ip_forward* | \
      *accept_dad* | *accept_ra* | *net.ipv4.conf.default.* | \
      *net.ipv6.conf.default.* | *net.ipv6.conf.all.forwarding* | \
      *net/ipv6/conf/all/forwarding*)
      return 0
      ;;
  esac
  return 1
}

create_container() {
  local lock_acquired=false
  if [[ -z "$DEVBOX_LOCK_FD" ]]; then
    if ! acquire_devbox_lock; then
      return 1
    fi
    lock_acquired=true
  fi

  # A second launcher may have observed the container as absent while the
  # first launcher was creating it. Re-check under the lock before doing any
  # image build or container replacement.
  if container_exists; then
    if [[ "$lock_acquired" == true ]]; then
      release_devbox_lock
    fi
    return 0
  else
    local status=$?
    if [ "$status" -ne 1 ]; then
      if [[ "$lock_acquired" == true ]]; then
        release_devbox_lock
      fi
      return "$status"
    fi
  fi

  local create_status
  if create_container_locked; then
    create_status=0
  else
    create_status=$?
  fi
  if [[ "$lock_acquired" == true ]]; then
    release_devbox_lock
  fi
  return "$create_status"
}

# Linked git worktrees keep their repository metadata outside the worktree
# directory: `$BIND_DIR/.git` is a pointer file recording a host-only
# `gitdir:` path that doesn't exist inside the container, which makes every
# Git operation from the mount fail (issue #148). When that happens, echo the
# host path of the repository's common git directory (the pointer chain's
# destination, containing objects/refs/config and the worktree admin dirs);
# echo nothing for normal checkouts or when the metadata already lives inside
# the bind mount (e.g. submodule gitdirs), so the container needs no extra
# mount in those cases.
git_worktree_metadata_dir() {
  local gitfile="$BIND_DIR/.git"
  [ -f "$gitfile" ] || return 0

  local gitdir
  gitdir="$(
    sed -n '1{s/^gitdir:[[:space:]]*//;s/[[:space:]]*$//;p}' "$gitfile" 2>/dev/null
  )"
  [ -n "$gitdir" ] || return 0

  case "$gitdir" in
    /*) ;;
    *) gitdir="$BIND_DIR/$gitdir" ;;
  esac
  gitdir="$(realpath -m -- "$gitdir" 2>/dev/null)" || return 0

  # Metadata inside the bind mount is already visible in the container.
  case "$gitdir/" in
    "$BIND_DIR/"*) return 0 ;;
  esac

  # The pointer targets a worktree's administrative gitdir; the common gitdir
  # recorded in `commondir` holds it under `worktrees/`, so mounting the
  # common gitdir makes the whole pointer chain resolvable. Git treats an
  # empty `commondir` as "the common dir is the gitdir itself".
  if [ -f "$gitdir/commondir" ]; then
    local commondir
    commondir="$(head -n 1 -- "$gitdir/commondir" 2>/dev/null)"
    if [ -n "$commondir" ]; then
      case "$commondir" in
        /*) ;;
        *) commondir="$gitdir/$commondir" ;;
      esac
      gitdir="$(realpath -m -- "$commondir" 2>/dev/null)" || return 0
    fi
  fi

  # The pointer is repository-controlled content, so only ever mount a
  # directory that is actually a git directory; this keeps a crafted pointer
  # from exfiltrating unrelated host paths (e.g. $HOME/.ssh) into the
  # container.
  [ -f "$gitdir/HEAD" ] || return 0
  printf '%s' "$gitdir"
}

create_container_locked() {
  local source_fingerprint
  source_fingerprint="$(container_context_fingerprint)"
  local context_image_tag
  context_image_tag="$(devbox_context_image_tag "$source_fingerprint")"
  DEVBOX_IMAGE_TAG="$(devbox_runtime_image_tag "$source_fingerprint")"

  if podman image exists "$context_image_tag" >/dev/null 2>&1; then
    echo "==> Reusing devbox image '$context_image_tag'"
  else
    echo "==> Building devbox image '$context_image_tag'"
    podman build \
      --layers \
      --file "$HERE/container/Dockerfile" \
      --tag "$context_image_tag" \
      "$HERE/container"
  fi

  if [[ "$DEVBOX_IMAGE_TAG" == "devbox:latest" ]]; then
    local context_image latest_image
    context_image="$(podman image inspect -f '{{.Id}}' "$context_image_tag")"
    latest_image="$(podman image inspect -f '{{.Id}}' "$DEVBOX_IMAGE_TAG" 2>/dev/null || true)"
    if [[ "$context_image" != "$latest_image" ]]; then
      podman tag "$context_image_tag" "$DEVBOX_IMAGE_TAG"
    fi
  fi

  # Look up the sandbox account's UID/GID from the image instead of
  # hardcoding them, so this keeps working if the base image ever changes
  # them.
  local sandbox_uid sandbox_gid
  sandbox_uid="$(podman run --rm "$DEVBOX_IMAGE_TAG" id -u sandbox)"
  sandbox_gid="$(podman run --rm "$DEVBOX_IMAGE_TAG" id -g sandbox)"

  local params=()
  # Each entry is a complete OpenCode config object. They are merged below so
  # every integration can contribute any config item.
  local opencode_config=()

  # Bind-mount the current working directory into the container at /sandbox/<dirname>
  params+=(
    --volume "$BIND_DIR:$WORKDIR" \
  )

  # For a linked worktree, mount the repository's git directory at its same
  # host path so the `.git` pointer file resolves inside the container too.
  local git_metadata_dir
  git_metadata_dir="$(git_worktree_metadata_dir)"
  if [ -n "$git_metadata_dir" ]; then
    echo "==> Linked git worktree detected: also mounting git directory $git_metadata_dir"
    params+=(
      --volume "$git_metadata_dir:$git_metadata_dir" \
    )
  fi

  # A `.venv` created on the host contains interpreter paths and script
  # shebangs that only exist on the host, so `uv run` (and anything else that
  # discovers `.venv`) fails with e.g. "Failed to spawn: pytest" when it
  # reuses one from a bind-mounted worktree. Shadow the project's `.venv`
  # with a container-local named volume so tools create and use a
  # container-native environment instead; the host directory is never read,
  # written, or chowned. A symlinked `.venv` can't be shadowed safely (its
  # mount target wouldn't resolve inside the container), so warn instead.
  if [ -L "$BIND_DIR/.venv" ]; then
    echo "==> WARNING: $BIND_DIR/.venv is a symlink and cannot be shadowed by a container-local environment; recreate it inside devbox (e.g. 'rm .venv && uv sync')" >&2
  elif [ -d "$BIND_DIR/.venv" ]; then
    local venv_volume="devbox-venv-${NAME#devbox-}"
    echo "==> Shadowing host .venv with container-local volume '$venv_volume'"
    params+=(
      --volume "$venv_volume:$WORKDIR/.venv" \
    )
  elif [ -e "$BIND_DIR/.venv" ]; then
    echo "==> WARNING: $BIND_DIR/.venv exists but is not a directory and cannot be shadowed; uv may reuse host-only interpreter paths from it" >&2
  fi

  # Persistent storage shared across *all* devbox instances (not just this
  # directory's container):
  #   - The knowledge base, Go, uv/pre-commit, and Semble caches use Podman-managed named
  #     volumes: their host-side location doesn't matter, and rootless Podman
  #     gives them the same keep-id-aware ownership handling as the bind mounts
  #     above.
  #   - Nested Podman/Buildah's own image and layer storage
  #     (/sandbox/.local/share/containers/storage, per storage.conf's
  #     default graphroot) instead uses a host-backed directory, so its
  #     size can be inspected and pruned with ordinary host tools (`du`,
  #     `rm -rf`) without needing `podman volume` commands.
  local podman_storage_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/containers-storage"
  mkdir -p "$podman_storage_cache_dir"
  params+=(
    --volume "devbox-kb:/sandbox/kb" \
    --volume "devbox-go-cache:/sandbox/.cache/go" \
    --volume "devbox-uv-cache:/sandbox/.uv_cache" \
    --volume "devbox-precommit-cache:/sandbox/.cache/pre-commit" \
    --volume "devbox-semble-cache:/sandbox/.cache/semble" \
    --volume "$podman_storage_cache_dir:/sandbox/.local/share/containers/storage" \
  )

  # Set safe defaults for paths that OpenCode can access from the devbox.
  # OpenCode v2 consolidates google-vertex-anthropic into google-vertex, so
  # carrying forward the old exclusion would also hide Vertex Gemini models.
  opencode_config+=(
    "$(cat <<'EOF'
{
  "disabled_providers": [
    "github-copilot",
    "gitlab"
  ],
  "permissions": [
    {"action": "external_directory", "resource": "/home/*", "effect": "allow"},
    {"action": "external_directory", "resource": "/root/*", "effect": "deny"},
    {"action": "external_directory", "resource": "/sandbox/*", "effect": "allow"},
    {"action": "external_directory", "resource": "/tmp/*", "effect": "allow"}
  ]
}
EOF
)"
  )

  # Semble MCP integration. The model is baked into the image and the index
  # cache is backed by a shared named volume, so this stays local after build.
  opencode_config+=(
    "$(cat <<'EOF'
{
  "mcp": {
    "servers": {
      "semble": {
        "type": "local",
        "command": ["semble"],
        "disabled": false
      }
    }
  }
}
EOF
)"
  )

  # Atlassian CLI (acli) configuration
  if [ -d "$HOME/.config/acli" ]; then
    params+=(
      --volume "$HOME/.config/acli:/sandbox/.config/acli" \
    )
  fi

  # Make the user's global skills available inside the devbox when present.
  if [ -d "$HOME/.agents" ]; then
    params+=(
      --volume "$HOME/.agents:/sandbox/.agents" \
    )
  fi

  # Gemini API
  if [ -n "${GEMINI_API_KEY:-}" ]; then
    params+=(
      --env "GEMINI_API_KEY=${GEMINI_API_KEY:-}" \
      --env "GOOGLE_GENERATIVE_AI_API_KEY=${GEMINI_API_KEY:-}" \
    )
  fi

  # GitHub CLI (gh) configuration and OpenCode GitHub MCP integration
  local github_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [ -z "$github_token" ] && command -v gh >/dev/null 2>&1; then
    github_token="$(gh auth token 2>/dev/null || true)"
  fi
  if [ -n "$github_token" ]; then
    params+=(
      --env "GH_TOKEN=$github_token" \
      --env "GITHUB_TOKEN=$github_token" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["github-mcp-server-proxy"],
        "disabled": false,
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GH_TOKEN}",
          "GITHUB_TOOLSETS": "context,repos,issues,pull_requests,users"
        }
      }
    }
  }
}
EOF
)"
    )
  fi

  # Context7 MCP integration
  if [ -n "${CONTEXT7_API_KEY:-}" ]; then
    params+=(
      --env "CONTEXT7_API_KEY=${CONTEXT7_API_KEY:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      }
    }
  }
}
EOF
)"
    )
  fi

  # Tavily MCP integration
  if [ -n "${TAVILY_API_KEY:-}" ]; then
    params+=(
      --env "TAVILY_API_KEY=${TAVILY_API_KEY:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "servers": {
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:TAVILY_API_KEY}"
        },
        "disabled": false
      }
    }
  }
}
EOF
)"
    )
  fi

  # The Source MCP integration
  if [ -n "${IGLOO_MCP_COMMUNITY:-}" ] \
    && [ -n "${IGLOO_MCP_COMMUNITY_KEY:-}" ] \
    && [ -n "${IGLOO_MCP_APP_PASS:-}" ] \
    && [ -n "${IGLOO_MCP_APP_ID:-}" ] \
    && [ -n "${IGLOO_MCP_USERNAME:-}" ] \
    && [ -n "${IGLOO_MCP_PASSWORD:-}" ]; then
    params+=(
      --env "IGLOO_MCP_COMMUNITY=${IGLOO_MCP_COMMUNITY:-}" \
      --env "IGLOO_MCP_COMMUNITY_KEY=${IGLOO_MCP_COMMUNITY_KEY:-}" \
      --env "IGLOO_MCP_APP_PASS=${IGLOO_MCP_APP_PASS:-}" \
      --env "IGLOO_MCP_APP_ID=${IGLOO_MCP_APP_ID:-}" \
      --env "IGLOO_MCP_USERNAME=${IGLOO_MCP_USERNAME:-}" \
      --env "IGLOO_MCP_PASSWORD=${IGLOO_MCP_PASSWORD:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "servers": {
      "the-source": {
        "disabled": false,
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/johnstrunk/igloo-mcp",
          "igloo-mcp"
        ],
        "environment": {
          "IGLOO_MCP_COMMUNITY": "{env:IGLOO_MCP_COMMUNITY}",
          "IGLOO_MCP_COMMUNITY_KEY": "{env:IGLOO_MCP_COMMUNITY_KEY}",
          "IGLOO_MCP_APP_PASS": "{env:IGLOO_MCP_APP_PASS}",
          "IGLOO_MCP_APP_ID": "{env:IGLOO_MCP_APP_ID}",
          "IGLOO_MCP_USERNAME": "{env:IGLOO_MCP_USERNAME}",
          "IGLOO_MCP_PASSWORD": "{env:IGLOO_MCP_PASSWORD}",
          "IGLOO_MCP_SERVER_NAME": "The Source",
