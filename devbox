#!/usr/bin/env bash
# Single-command launcher: OpenShell replacement for devcontainer launch.
#
# Runs as a fully rootless Podman container: the main process keeps the
# image's built-in "sandbox" account (via `--userns=keep-id`), so files
# created in the container land on the host owned by the invoking user,
# with no runtime UID/GID remapping or ownership fix-up required. The image
# also bundles a rootless, nested Podman (Podman-in-Podman) so the sandbox
# can build/run its own containers without the outer container needing
# --privileged or any added Linux capabilities.
#
# Bind-mounts the *current working directory* into a per-directory
# container (named "devbox-<dirname>"). This is meant to be symlinked onto
# $PATH (e.g. `ln -s /path/to/this/repo/devbox ~/bin/devbox`), so a user can
# simply `cd` into whatever project they want to work on and run `devbox`:
#   - If the container for that directory doesn't already exist, it's
#     created (building the image first, if needed) with the current
#     directory bind-mounted in.
#   - If it already exists, this just execs a shell or the provided command
#     into it (starting it first if it's currently stopped).
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BIND_DIR="$(realpath "$PWD")"
NAME="devbox-$(basename "$BIND_DIR")"
WORKDIR="/sandbox/$(basename "$BIND_DIR")"
SOURCE_FINGERPRINT_LABEL="io.github.johnstrunk.my-sandbox.devbox-context-fingerprint"

# Clear XDG_DATA_HOME so `devbox` works inside vscode terminal sessions
export XDG_DATA_HOME=

usage() {
  cat <<EOF
Usage: $(basename "$0") [-r|--remove] [--recreate|--new] [-h|--help] [--] [command [arg ...]]

Bind-mounts the current directory ($BIND_DIR) into a devbox container
named '$NAME': creating it if it doesn't exist, or exec'ing a command/shell
into it if it does.

Options:
  -r, --remove        Stop and remove the container for this directory
      --recreate,
      --new           Remove the container (if it exists) and create a
                       fresh one
  -h, --help          Show this help message

Arguments:
  command [arg ...]   Command to run in the container (default: /bin/bash)
EOF
}

container_context_fingerprint() {
  (
    cd "$HERE/container"
    find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum
  ) | sha256sum | cut -d ' ' -f 1
}

container_is_stale() {
  local expected_fingerprint="$1"
  local recorded_fingerprint container_image current_image

  recorded_fingerprint="$(podman inspect \
    -f "{{ index .Config.Labels \"$SOURCE_FINGERPRINT_LABEL\" }}" \
    "$NAME" 2>/dev/null || true)"
  container_image="$(podman inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)"
  current_image="$(podman image inspect -f '{{.Id}}' devbox:latest 2>/dev/null || true)"

  if [ "$recorded_fingerprint" = "$expected_fingerprint" ] \
    && [ -n "$current_image" ] \
    && [ "$container_image" = "$current_image" ]; then
    return 1
  fi
  return 0
}

warn_stale_container() {
  echo "==> Existing container '$NAME' is stale or cannot be verified against the current devbox image." >&2
  echo "    Run 'devbox --recreate' to refresh it; the host-backed project directory is preserved." >&2
}

ACTION="run"
COMMAND=()
while [ $# -gt 0 ]; do
  case "$1" in
    -r | --remove)
      ACTION="remove"
      shift
      ;;
    --recreate | --new)
      ACTION="recreate"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      COMMAND=("$@")
      break
      ;;
  esac
done

remove_container() {
  if podman container exists "$NAME" 2>/dev/null; then
    echo "==> Removing container '$NAME'"
    podman stop "$NAME" >/dev/null 2>&1 || true
    podman rm "$NAME" >/dev/null 2>&1 || true
  else
    echo "==> Container '$NAME' does not exist; nothing to remove"
  fi
}

create_container() {
  local source_fingerprint
  source_fingerprint="$(container_context_fingerprint)"

  podman build \
    --layers \
    --file "$HERE/container/Dockerfile" \
    --tag "devbox:latest" \
    "$HERE/container"

  # Look up the sandbox account's UID/GID from the image instead of
  # hardcoding them, so this keeps working if the base image ever changes
  # them.
  local sandbox_uid sandbox_gid
  sandbox_uid="$(podman run --rm "devbox:latest" id -u sandbox)"
  sandbox_gid="$(podman run --rm "devbox:latest" id -g sandbox)"

  local params=()
  # Each entry is a complete OpenCode config object. They are merged below so
  # every integration can contribute any config item.
  local opencode_config=()

  # Bind-mount the current working directory into the container at /sandbox/<dirname>
  params+=(
    --volume "$BIND_DIR:$WORKDIR" \
  )

  # Persistent caches shared across *all* devbox instances (not just this
  # directory's container), so recreating a container doesn't repeat
  # downloads/builds whose inputs haven't changed:
  #   - uv's package cache and pre-commit's hook environments use
  #     Podman-managed named volumes: their host-side location doesn't
  #     matter, and rootless Podman gives them the same keep-id-aware
  #     ownership handling as the bind mounts above.
  #   - Nested Podman/Buildah's own image and layer storage
  #     (/sandbox/.local/share/containers/storage, per storage.conf's
  #     default graphroot) instead uses a host-backed directory, so its
  #     size can be inspected and pruned with ordinary host tools (`du`,
  #     `rm -rf`) without needing `podman volume` commands.
  local podman_storage_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/containers-storage"
  mkdir -p "$podman_storage_cache_dir"
  params+=(
    --volume "devbox-uv-cache:/sandbox/.uv_cache" \
    --volume "devbox-precommit-cache:/sandbox/.cache/pre-commit" \
    --volume "$podman_storage_cache_dir:/sandbox/.local/share/containers/storage" \
  )

  # Allow access to /tmp and /sandbox w/o prompting
  opencode_config+=(
    "$(cat <<'EOF'
{
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/sandbox/**": "allow",
      "/sandbox/.cache/pre-commit/**": "allow",
      "/sandbox/.*": "ask"
    }
  }
}
EOF
)"
  )

  # Atlassian CLI (acli) configuration
  if [ -d "$HOME/.config/acli" ]; then
    params+=(
      --volume "$HOME/.config/acli:/sandbox/.config/acli" \
    )
  fi

  # Gemini API
  if [ -n "${GEMINI_API_KEY:-}" ]; then
    params+=(
      --env "GEMINI_API_KEY=${GEMINI_API_KEY:-}" \
      --env "GOOGLE_GENERATIVE_AI_API_KEY=${GEMINI_API_KEY:-}" \
    )
  fi

  # GitHub CLI (gh) configuration and OpenCode GitHub MCP integration
  local github_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [ -z "$github_token" ] && command -v gh >/dev/null 2>&1; then
    github_token="$(gh auth token 2>/dev/null || true)"
  fi
  if [ -n "$github_token" ]; then
    params+=(
      --env "GH_TOKEN=$github_token" \
      --env "GITHUB_TOKEN=$github_token" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "devbox-github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}"
      }
    }
  }
}
EOF
)"
    )
  fi

  # Context7 MCP integration
  if [ -n "${CONTEXT7_API_KEY:-}" ]; then
    params+=(
      --env "CONTEXT7_API_KEY=${CONTEXT7_API_KEY:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
EOF
)"
    )
  fi

  # The Source MCP integration
  if [ -n "${IGLOO_MCP_COMMUNITY:-}" ] \
    && [ -n "${IGLOO_MCP_COMMUNITY_KEY:-}" ] \
    && [ -n "${IGLOO_MCP_APP_PASS:-}" ] \
    && [ -n "${IGLOO_MCP_APP_ID:-}" ] \
    && [ -n "${IGLOO_MCP_USERNAME:-}" ] \
    && [ -n "${IGLOO_MCP_PASSWORD:-}" ]; then
    params+=(
      --env "IGLOO_MCP_COMMUNITY=${IGLOO_MCP_COMMUNITY:-}" \
      --env "IGLOO_MCP_COMMUNITY_KEY=${IGLOO_MCP_COMMUNITY_KEY:-}" \
      --env "IGLOO_MCP_APP_PASS=${IGLOO_MCP_APP_PASS:-}" \
      --env "IGLOO_MCP_APP_ID=${IGLOO_MCP_APP_ID:-}" \
      --env "IGLOO_MCP_USERNAME=${IGLOO_MCP_USERNAME:-}" \
      --env "IGLOO_MCP_PASSWORD=${IGLOO_MCP_PASSWORD:-}" \
    )
    opencode_config+=(
      "$(cat <<'EOF'
{
  "mcp": {
    "the-source": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/johnstrunk/igloo-mcp",
        "igloo-mcp"
      ],
      "environment": {
        "IGLOO_MCP_COMMUNITY": "{env:IGLOO_MCP_COMMUNITY}",
        "IGLOO_MCP_COMMUNITY_KEY": "{env:IGLOO_MCP_COMMUNITY_KEY}",
        "IGLOO_MCP_APP_PASS": "{env:IGLOO_MCP_APP_PASS}",
        "IGLOO_MCP_APP_ID": "{env:IGLOO_MCP_APP_ID}",
        "IGLOO_MCP_USERNAME": "{env:IGLOO_MCP_USERNAME}",
        "IGLOO_MCP_PASSWORD": "{env:IGLOO_MCP_PASSWORD}",
        "IGLOO_MCP_SERVER_NAME": "The Source",
        "IGLOO_MCP_SERVER_INSTRUCTIONS": "This server provides search and fetch capabilities for The Source, Red Hat's intranet, containing articles with guides, instructions, and useful information that helps team members do their jobs and contribute to Red Hat."
      }
    }
  }
}
EOF
)"
    )
  fi

  # GitLab CLI (glab) configuration
  if [ -n "${GITLAB_TOKEN:-}" ]; then
    params+=(
      --env "GITLAB_HOST=${GITLAB_HOST:-gitlab.com}" \
      --env "GITLAB_TOKEN=${GITLAB_TOKEN:-}" \
    )
  fi

  # Google Workspace CLI (gws) configuration
  if [ -d "$HOME/.config/gws" ]; then
    params+=(
      --volume "$HOME/.config/gws:/sandbox/.config/gws" \
    )
  fi

  # LiteMaaS configuration
  if [ -n "${LITEMAAS_API_KEY:-}" ]; then
    params+=(
      --env "LITEMAAS_API_KEY=${LITEMAAS_API_KEY:-}" \
    )
  fi

  # OpenAI configuration
  if [ -n "${OPENAI_API_KEY:-}" ]; then
    params+=(
      --env "OPENAI_API_KEY=${OPENAI_API_KEY:-}" \
    )
  fi

  # Anthropic configuration
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    params+=(
      --env "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
    )
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    params+=(
      --env "ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}" \
    )
  fi

  # OpenCode session data and configuration
  if [ -d "$HOME/.local/share/opencode" ]; then
    params+=(
      --volume "$HOME/.local/share/opencode:/sandbox/.local/share/opencode" \
    )
  fi
  if [ -d "$HOME/.config/opencode" ]; then
    params+=(
      --volume "$HOME/.config/opencode:/sandbox/.config/opencode" \
    )
  fi
  if [ -d "$HOME/.local/state/opencode" ]; then
    params+=(
      --volume "$HOME/.local/state/opencode:/sandbox/.local/state/opencode" \
    )
  elif [ -f "$HOME/.local/state/opencode/model.json" ]; then
    params+=(
      --volume "$HOME/.local/state/opencode/model.json:/sandbox/.local/state/opencode/model.json" \
    )
  fi
  if [ -f "$HERE/opencode.json" ]; then
    params+=(
      --volume "$HERE/opencode.json:/sandbox/opencode.json" \
    )
  fi

  # Vertex AI configuration
  if [ -n "${GOOGLE_CLOUD_PROJECT:-}" ] && [ -n "${VERTEX_LOCATION:-}" ]; then
    params+=(
      --env "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}" \
      --env "VERTEX_LOCATION=${VERTEX_LOCATION:-global}" \
    )
  fi
  if [ -f "$HOME/.config/gcloud/application_default_credentials.json" ]; then
    params+=(
      --volume "$HOME/.config/gcloud/application_default_credentials.json:/sandbox/.config/gcloud/application_default_credentials.json" \
    )
  fi

  if [ "${#opencode_config[@]}" -gt 0 ]; then
    local opencode_config_content
    opencode_config_content="$({
      printf '%s\n' "{\"\$schema\":\"https://opencode.ai/config.json\"}"
      printf '%s\n' "${opencode_config[@]}"
    } | podman run --rm -i "devbox:latest" jq -s -c \
      "reduce .[] as \$item ({}; . * \$item)")"
    params+=(
      --env "OPENCODE_CONFIG_CONTENT=$opencode_config_content" \
    )
  fi

  echo "==> Creating container '$NAME'"
  podman run -d \
    --user sandbox \
    --userns "keep-id:uid=$sandbox_uid,gid=$sandbox_gid" \
    --name "$NAME" \
    --label "$SOURCE_FINGERPRINT_LABEL=$source_fingerprint" \
    --stop-timeout 0 \
    --device /dev/fuse \
    --device /dev/net/tun \
    --security-opt label=disable \
    "${params[@]}" \
    "devbox:latest"

  # --userns=keep-id gives this container's own user namespace a limited
  # range of usable IDs (0..N, where N is determined by the invoking host
  # user's own /etc/subuid/subgid allocation -- it can't be known at image
  # build time). Nested Podman's subordinate ID delegation (/etc/subuid,
  # /etc/subgid, consumed by its own newuidmap/newgidmap when it builds a
  # user namespace for the containers *it* runs) must fit entirely within
  # that range: per user_namespaces(7), "the mapped user IDs must in turn
  # have a mapping in the parent user namespace." A range outside it (e.g.
  # a fixed build-time guess) makes nested `podman run` fail with
  # "newuidmap: write to uid_map failed: Operation not permitted".
  #
  # Compute the actual available range from the running container's own
  # uid_map/gid_map, and split the delegation into the two chunks before
  # and after sandbox's own ID (skipping it, and skipping ID 0 -- mapping a
  # nested ID to the parent's UID/GID 0 additionally requires CAP_SETFCAP,
  # which sandbox doesn't have; see user_namespaces(7)) to make full use of
  # the available range. This mirrors podman's own reference image, whose
  # /etc/subuid delegates "podman:1:999" plus "podman:1001:64535" around
  # its "podman" user's identity of 1000:
  # https://github.com/containers/podman/blob/main/contrib/podmanimage/stable/Dockerfile
  echo "==> Configuring nested Podman's subordinate UID/GID delegation"
  local max_uid max_gid
  max_uid="$(podman exec "$NAME" awk '{ if ($1 + $3 - 1 > max) max = $1 + $3 - 1 } END { print max }' /proc/self/uid_map)"
  max_gid="$(podman exec "$NAME" awk '{ if ($1 + $3 - 1 > max) max = $1 + $3 - 1 } END { print max }' /proc/self/gid_map)"
  subid_ranges() { # id max -> "sandbox:..." subuid/subgid lines around $id
    local id="$1" max="$2"
    if [ "$id" -gt 1 ]; then
      echo "sandbox:1:$((id - 1))"
    fi
    if [ "$max" -gt "$id" ]; then
      echo "sandbox:$((id + 1)):$((max - id))"
    fi
  }
  podman exec -u 0:0 "$NAME" sed -i '/^sandbox:/d' /etc/subuid /etc/subgid
  subid_ranges "$sandbox_uid" "$max_uid" | podman exec -i -u 0:0 "$NAME" tee -a /etc/subuid >/dev/null
  subid_ranges "$sandbox_gid" "$max_gid" | podman exec -i -u 0:0 "$NAME" tee -a /etc/subgid >/dev/null

  # Podman auto-creates missing parent directories for bind-mounted
  # files/dirs (e.g. the opencode model.json mount above) as root, ignoring
  # --userns=keep-id's UID mapping for the container's "sandbox" user. Fix
  # up any such root-owned directories under /sandbox, without recursing
  # into the actual bind-mounted content (-xdev stops at the mount
  # boundary, so this only touches the container's own filesystem, never
  # files on the host).
  echo "==> Fixing ownership of any root-owned bind-mount parent directories"
  podman exec -u 0:0 "$NAME" \
    find /sandbox -xdev \( ! -uid "$sandbox_uid" -o ! -gid "$sandbox_gid" \) \
    -exec chown -h "$sandbox_uid:$sandbox_gid" {} + 2>/dev/null || true

  # Git identity: a fresh sandbox account has no Git identity configured,
  # so an uninformed `git commit` inside the container fails with Git's
  # "empty ident name" error. Fill in only whatever is missing, using the
  # *invoking host user's* `git config --global user.name`/`user.email`
  # as the source of truth -- never data baked into the image, and this
  # never reads or writes the host's Git config beyond that lookup. Any
  # identity already configured inside this (persistent) container is
  # left untouched.
  echo "==> Configuring Git identity"
  local existing_git_name existing_git_email
  existing_git_name="$(podman exec "$NAME" git config --global user.name 2>/dev/null || true)"
  existing_git_email="$(podman exec "$NAME" git config --global user.email 2>/dev/null || true)"

  if [ -z "$existing_git_name" ]; then
    local host_git_name
    host_git_name="$(git config --global user.name 2>/dev/null || true)"
    if [ -n "$host_git_name" ]; then
      if podman exec "$NAME" git config --global user.name "$host_git_name"; then
        existing_git_name="$host_git_name"
      else
        echo "    WARNING: Failed to set Git user.name inside the container." >&2
      fi
    fi
  fi
  if [ -z "$existing_git_email" ]; then
    local host_git_email
    host_git_email="$(git config --global user.email 2>/dev/null || true)"
    if [ -n "$host_git_email" ]; then
      if podman exec "$NAME" git config --global user.email "$host_git_email"; then
        existing_git_email="$host_git_email"
      else
        echo "    WARNING: Failed to set Git user.email inside the container." >&2
      fi
    fi
  fi

  if [ -z "$existing_git_name" ] || [ -z "$existing_git_email" ]; then
    echo "    WARNING: Git user.name and/or user.email are not configured (checked the container and the host)." >&2
    echo "    Commits inside the devbox will fail until you run, inside the container:" >&2
    echo '      git config --global user.name "Your Name"' >&2
    echo '      git config --global user.email "you@example.com"' >&2
    echo "    Or run 'git config --global user.name/user.email' on the host before starting devbox." >&2
  fi

  # GitHub authentication: the devbox has no usable SSH access to GitHub,
  # so Git operations over HTTPS against github.com must authenticate via
  # the `gh` CLI's credential helper rather than SSH keys or an agent.
  # `gh auth setup-git` reads whichever credentials `gh` already has (e.g.
  # the GH_TOKEN/GITHUB_TOKEN env var set above) each time Git needs them,
  # so this only needs to register the helper once per container.
  if [ -n "$github_token" ]; then
    echo "==> Configuring gh as Git's credential helper for GitHub HTTPS operations"
    if ! podman exec "$NAME" gh auth setup-git; then
      echo "    WARNING: 'gh auth setup-git' failed; Git HTTPS operations against github.com may fail or prompt for credentials." >&2
    fi
  else
    echo "    WARNING: No GitHub token available; Git HTTPS operations against github.com will fail until you run, inside the container:" >&2
    echo "      gh auth login && gh auth setup-git" >&2
    echo "    Or set GH_TOKEN/GITHUB_TOKEN, or log in with 'gh auth login' on the host, before starting devbox." >&2
  fi
}

enter_container() {
  if [ "$(podman inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
    echo "==> Starting container '$NAME'"
    podman start "$NAME" >/dev/null
  fi
  echo "==> Entering container '$NAME'"
  local exec_opts=("-i")
  if [ -t 0 ] && [ -t 1 ]; then
    exec_opts+=("-t")
  fi
  if [ $# -eq 0 ]; then
    exec podman exec "${exec_opts[@]}" -w "$WORKDIR" "$NAME" /bin/bash
  else
    exec podman exec "${exec_opts[@]}" -w "$WORKDIR" "$NAME" "$@"
  fi
}

case "$ACTION" in
  remove)
    remove_container
    ;;
  recreate)
    remove_container
    create_container
    enter_container "${COMMAND[@]}"
    ;;
  run)
    if ! podman container exists "$NAME" 2>/dev/null; then
      create_container
    else
      expected_source_fingerprint="$(container_context_fingerprint)"
      if container_is_stale "$expected_source_fingerprint"; then
        warn_stale_container
      fi
    fi
    enter_container "${COMMAND[@]}"
    ;;
esac
