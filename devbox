    }
  }
}
EOF
)"
    )
  fi

  # Anthropic configuration
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    params+=(
      --env "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}" \
    )
  fi
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    params+=(
      --env "ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}" \
    )
  fi

  # Configure optional Pricetag provider overrides. The shared API key is
  # required for either interface, but each interface has its own endpoint.
  local pricetag_enabled=false
  if [ -n "${PRICETAG_API_KEY:-}" ]; then
    if [ -n "${PRICETAG_ANTHROPIC_URL:-}" ]; then
      pricetag_enabled=true
      params+=(
        --env "PRICETAG_ANTHROPIC_URL=${PRICETAG_ANTHROPIC_URL:-}" \
      )
      opencode_config+=(
        "$(cat <<EOF
{
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "{env:PRICETAG_ANTHROPIC_URL}",
        "apiKey": "{env:PRICETAG_API_KEY}"
      }
    }
  }
}
EOF
)"
      )
    fi

    if [ -n "${PRICETAG_HOSTED_URL:-}" ]; then
      pricetag_enabled=true
      params+=(
        --env "PRICETAG_HOSTED_URL=${PRICETAG_HOSTED_URL:-}" \
      )
      # Manually check the currently offered hosted models periodically:
      # curl --fail --silent --show-error --location --connect-timeout 5 --max-time 15 \
      #   -H "x-api-key: ${PRICETAG_API_KEY}" \
      #   https://ai-gateway-unified-ai-gateway-dogfood.dogfood-us-south-1-bxf-4x-f196230f74f7ff44a5b4eeb1003c5bd5-0000.us-south.containers.appdomain.cloud/v1/models | jq -r .
      opencode_config+=(
        "$(cat <<'EOF'
