#!/usr/bin/env bash

set -euo pipefail

# Keep all repository operations and the agent run inside the shared Lima VM.
# `devbox` is only the host-to-VM transport here; the guest runs the commands
# at the same project path and receives the filtered gh/provider environment.
devbox bash -c 'git switch main && git pull --ff-only'

# OpenCode v2 dropped `run --command` (and `--variant`); commands are only
# expanded by the interactive clients. Attach the command file to a headless
# `opencode run` instead and specify its model explicitly.
devbox opencode run \
  --agent build \
  --model openai/rits/zai-org/glm-5-3 \
  --file .opencode/commands/grab-issue.md \
  "Execute the task list in the attached file."

devbox bash -c 'git switch main && git pull --ff-only'
