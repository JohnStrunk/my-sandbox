{
  // JSON5 spec: https://json5.org/
  // Renovate docs: https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended", // Use recommended settings
    "helpers:pinGitHubActionDigests", // Pin GitHub action digests
    ":enablePreCommit", // Enable updates to pre-commit repos
    ":gitSignOff", // Add Signed-off-by line to commit messages
    ":pinDependencies", // Pin dependencies
    ":pinDevDependencies" // Pin dev dependencies also
  ],
  // Files to ignore
  "ignorePaths": [
    ".venv",
  ],
  "labels": [
    "dependencies",
  ],
  "lockFileMaintenance": {
    "enabled": true,
  },
  "minimumReleaseAge": "10 days",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      // ast-grep's manifest entry also pins platform release checksums and the
      // official agent-skill archive hash. Renovate cannot recompute those, so
      // a version-only bump is caught by the "Verify release provenance
      // checksums" CI step; run the refresh command below to update the whole
      // unit together.
      "description": "ast-grep version bumps must refresh release checksums + agent-skill pin",
      "matchPackageNames": [
        "ast-grep/ast-grep",
      ],
      "commitMessageSuffix": "(refresh release checksums + agent-skill pin via scripts/verify_provenance.py --update)",
    },
    {
      // Lima provisioning reads release checksums from the manifest at
      // runtime; Renovate cannot recompute them, so a version-only bump is
      // caught by the "Verify release provenance checksums" CI step.
      "description": "limactl version bumps must refresh release checksums",
      "matchPackageNames": [
        "lima-vm/lima",
      ],
      "commitMessageSuffix": "(refresh release checksums via scripts/verify_provenance.py --update)",
    },
    {
      "description": "Release binary version bumps must refresh manifest checksums",
      "matchPackageNames": [
        "hadolint/hadolint",
        "golang",
        "astral-sh/uv",
        "node",
        "rust-lang/rustup",
        "google-antigravity/antigravity-cli",
        "acli",
        "helm/helm",
        "kubernetes-sigs/kind",
        "kubernetes/kubernetes",
      ],
      "commitMessageSuffix": "(refresh release checksums with scripts/verify_provenance.py --update)",
    },
    {
      "description": "Update golang version in the canonical manifest",
      "groupName": "golang version",
      "matchDepNames": [
        "go",
        "golang",
      ],
      // Keep after the release-checksum rule so this conditional reminder wins.
      "commitMessageSuffix": "(run scripts/verify_provenance.py --update if a provenance-pinned tool changes)",
    },
    {
      "description": "Keep canonical tool versions and their consumers together",
      "matchPackageNames": [
        "hadolint/hadolint",
        "ast-grep/ast-grep",
        "lima-vm/lima",
        "@opencode/cli",
        "astral-sh/uv",
        "helm/helm",
        "kubernetes-sigs/kind",
        "kubernetes/kubernetes",
        "node",
        "rust",
        "rust-lang/rustup",
        "pipenv",
        "markdownlint-cli2",
        "DavidAnson/markdownlint-cli2",
        "ruff",
        "astral-sh/ruff-pre-commit",
        "pre-commit/pre-commit-hooks",
        "pre-commit/pygrep-hooks",
        "adrienverge/yamllint",
        "Mergifyio/mergify-pre-commit",
        "renovatebot/pre-commit-hooks",
        "shellcheck-py/shellcheck-py",
        "Yelp/detect-secrets",
        "bmares/check-json5",
        "zizmorcore/zizmor-pre-commit",
      ],
      "groupName": "devbox tool versions",
      // Grouped PRs can drop individual checksum-refresh suffixes. Keep the
      // follow-up visible, while making clear it applies only to provenance pins.
      "commitMessageSuffix": "(run scripts/verify_provenance.py --update if a provenance-pinned tool changes)",
    },
    {
      "description": "Use loose versioning for ShellCheck's four-part tags",
      "matchManagers": [
        "pre-commit",
      ],
      "matchPackageNames": [
        "shellcheck-py/shellcheck-py",
      ],
      "versioning": "loose",
    },
    {
      "description": "Update renovatebot/pre-commit-hooks weekly to decrease noise",
      "matchPackageNames": [
        "renovatebot/pre-commit-hooks",
      ],
      "schedule": [
        "before 9am on monday",
      ],
    },
    {
      "description": "Keep overrides as ranges — they are security/compat floors",
      "matchDepTypes": [
        "overrides",
      ],
      "rangeStrategy": "replace",
    },
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rebaseWhen": "auto",
  // "schedule": ["before 7am on Tuesday"],
  "semanticCommits": "disabled",
  "timezone": "America/New_York",
  "customDatasources": {
    "acli": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases[$contains(version, \"version \")].{\"version\": $replace(version, /.*version \"([^\"]+)\".*/, \"$1\")}]}",
      ],
    },
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/(?:^|/)tool-versions\\.json$/",
      ],
      "matchStrings": [
        '$each(tools, function($v, $k) { {"depName": $v.depName, "currentValue": $v.version, "datasource": $v.datasource, "versioning": $v.versioning} })',
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-.]+)\\s+depName=(?<depName>[a-zA-Z0-9/@_.:-]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?\\s+(?:ARG\\s+)?[A-Z0-9_]+_VERSION=[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-.]+)\\s+depName=(?<depName>[a-zA-Z0-9/@_.:-]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s+[^#\\n]*?@(?<currentValue>[a-zA-Z0-9.-]+)",
      ],
    },
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": [
      "dependencies",
      "security",
    ],
  },
}
