{
  // JSON5 spec: https://json5.org/
  // Renovate docs: https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended", // Use recommended settings
    "helpers:pinGitHubActionDigests", // Pin GitHub action digests
    ":enablePreCommit", // Enable updates to pre-commit repos
    ":gitSignOff", // Add Signed-off-by line to commit messages
    ":pinDependencies", // Pin dependencies
    ":pinDevDependencies" // Pin dev dependencies also
  ],
  // Files to ignore
  "ignorePaths": [
    ".venv",
  ],
  "labels": [
    "dependencies",
  ],
  "lockFileMaintenance": {
    "enabled": true,
  },
  "minimumReleaseAge": "10 days",
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group hadolint version and architecture artifact updates",
      "matchPackageNames": [
        "hadolint/hadolint",
      ],
      "groupName": "hadolint release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group uv version and architecture artifact updates",
      "matchPackageNames": [
        "astral-sh/uv",
      ],
      "groupName": "uv release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group Antigravity CLI version and architecture artifact updates",
      "matchPackageNames": [
        "google-antigravity/antigravity-cli",
      ],
      "groupName": "antigravity cli release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group Lima version and architecture artifact updates",
      "matchPackageNames": [
        "lima-vm/lima",
      ],
      "groupName": "limactl release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group kind version and architecture artifact updates",
      "matchPackageNames": [
        "kubernetes-sigs/kind",
      ],
      "groupName": "kind release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group ast-grep version and architecture artifact updates",
      "matchPackageNames": [
        "ast-grep/ast-grep",
      ],
      "groupName": "ast-grep release artifacts",
      "minimumGroupSize": 3,
    },
    {
      "description": "Group acli version and architecture artifact updates",
      "matchPackageNames": [
        "acli",
      ],
      "groupName": "acli release artifacts",
      "minimumGroupSize": 3,
      "versioning": "loose",
    },
    {
      "description": "Allow acli's official formula feed, which has no release timestamp",
      "matchPackageNames": [
        "acli",
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
    {
      "description": "Keep canonical tool versions and their consumers together",
      "matchPackageNames": [
        "@opencode/cli",
        "golang",
        "helm/helm",
        "kubernetes/kubernetes",
        "node",
        "rust",
        "rust-lang/rustup",
        "pipenv",
        "markdownlint-cli2",
        "DavidAnson/markdownlint-cli2",
        "ruff",
        "astral-sh/ruff-pre-commit",
        "pre-commit/pre-commit-hooks",
        "pre-commit/pygrep-hooks",
        "adrienverge/yamllint",
        "Mergifyio/mergify-pre-commit",
        "renovatebot/pre-commit-hooks",
        "shellcheck-py/shellcheck-py",
        "Yelp/detect-secrets",
        "bmares/check-json5",
        "zizmorcore/zizmor-pre-commit",
      ],
      "groupName": "devbox tool versions",
    },
    {
      "description": "Use loose versioning for ShellCheck's four-part tags",
      "matchManagers": [
        "pre-commit",
      ],
      "matchPackageNames": [
        "shellcheck-py/shellcheck-py",
      ],
      "versioning": "loose",
    },
    {
      "description": "Update renovatebot/pre-commit-hooks weekly to decrease noise",
      "matchPackageNames": [
        "renovatebot/pre-commit-hooks",
      ],
      "schedule": [
        "before 9am on monday",
      ],
    },
    {
      "description": "Keep overrides as ranges — they are security/compat floors",
      "matchDepTypes": [
        "overrides",
      ],
      "rangeStrategy": "replace",
    },
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rebaseWhen": "auto",
  // "schedule": ["before 7am on Tuesday"],
  "semanticCommits": "disabled",
  "timezone": "America/New_York",
  "customDatasources": {
    "acli": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases[$contains(version, \"version \")].{\"version\": $replace(version, /.*version \"([^\"]+)\".*/, \"$1\")}]}",
      ],
    },
    "acli-amd64": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$$.releases#$i[$contains(version, \"https://acli.atlassian.com/linux/\") and $contains(version, \"linux_amd64.tar.gz\")].{\"version\": $split($split(version, \"/linux/\")[1], \"/\")[0], \"digest\": $replace($$.releases[$i + 1].version, /.*sha256 \"([0-9a-f]+)\".*/, \"$1\")}]}"
      ],
    },
    "acli-arm64": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/atlassian/homebrew-acli/main/Formula/acli.rb",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$$.releases#$i[$contains(version, \"https://acli.atlassian.com/linux/\") and $contains(version, \"linux_arm64.tar.gz\")].{\"version\": $split($split(version, \"/linux/\")[1], \"/\")[0], \"digest\": $replace($$.releases[$i + 1].version, /.*sha256 \"([0-9a-f]+)\".*/, \"$1\")}]}"
      ],
    },
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/(?:^|/)tool-versions\\.json$/",
      ],
      "matchStrings": [
        '$each(tools, function($v, $k) { {"depName": $v.depName, "packageName": $v.depName, "currentValue": $v.version, "datasource": $v.datasource, "versioning": $v.versioning} })',
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      "customType": "regex",
      "description": "Update each checksum-managed architecture artifact and digest",
      "managerFilePatterns": [
        "/(?:^|/)tool-versions\\.json$/",
      ],
      "matchStrings": [
        '"version": "(?<currentValue>[^"]+)"\\s*,\\s*"sha256": "(?<currentDigest>[0-9a-f]{64})"\\s*,\\s*"depName": "(?<depName>[^"]+)"\\s*,\\s*"packageName": "(?<packageName>[^"]+)"\\s*,\\s*"datasource": "(?<datasource>[^"]+)"',
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "autoReplaceStringTemplate": '"version": "{{{newValue}}}",\n          "sha256": "{{{newDigest}}}",\n          "depName": "{{{depName}}}",\n          "packageName": "{{{packageName}}}",\n          "datasource": "{{{datasource}}}"',
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-.]+)\\s+depName=(?<depName>[a-zA-Z0-9/@_.:-]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?\\s+(?:ARG\\s+)?[A-Z0-9_]+_VERSION=[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-.]+)\\s+depName=(?<depName>[a-zA-Z0-9/@_.:-]+)(?:\\s+versioning=(?<versioning>[a-z-]+))?\\s+[^#\\n]*?@(?<currentValue>[a-zA-Z0-9.-]+)",
      ],
    },
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": [
      "dependencies",
      "security",
    ],
  },
}
