#!/usr/bin/env bash
# Host-side entry point for a shell in the devbox Lima VM. Lima does not pass
# host environment variables into a guest shell by default. This wrapper
# forwards only the provider/integration variables used by ../devbox.
set -euo pipefail

instance="${DEVBOX_LIMA_INSTANCE:-devbox}"
repo_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
workdir=""
opencode_debug=unchanged
start_vm=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir)
      if [[ $# -lt 2 ]]; then
        echo "devbox: --workdir requires a guest path" >&2
        exit 2
      fi
      workdir="$2"
      shift 2
      ;;
    --no-start)
      start_vm=false
      shift
      ;;
    --opencode-debug)
      if [[ $# -lt 2 ]]; then
        echo "devbox: --opencode-debug requires enabled or disabled" >&2
        exit 2
      fi
      opencode_debug="$2"
      case "$opencode_debug" in
        enabled | disabled) ;;
        *)
          echo "devbox: invalid internal OpenCode debug mode" >&2
          exit 2
          ;;
      esac
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if ! command -v limactl >/dev/null 2>&1; then
  echo "devbox: limactl is not installed or not on PATH" >&2
  exit 127
fi

# The main launcher starts the VM under this same lock and passes --no-start.
# Direct helper use starts while locked, then connects without --start so a
# concurrent --stop cannot be undone after unlocking.
if [[ "$start_vm" == true ]]; then
  lock_root="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/locks"
  lock_file="$lock_root/lima-runtime.lock"
  lock_fd=""
  if ! mkdir -p "$lock_root" || ! chmod 700 "$lock_root" \
    || ! exec {lock_fd}>"$lock_file" || ! chmod 600 "$lock_file"; then
    echo "devbox: could not create or secure Lima lifecycle lock '$lock_file'" >&2
    exit 1
  fi
  if ! flock "$lock_fd"; then
    echo "devbox: could not acquire Lima lifecycle lock '$lock_file'" >&2
    exit 1
  fi
  if ! status="$(limactl list --format '{{.Status}}' "$instance" 2>/dev/null)"; then
    echo "devbox: could not inspect Lima instance '$instance'" >&2
    exit 1
  fi
  case "$status" in
    Running)
      ;;
    Stopped)
      echo "==> Starting Lima VM '$instance'"
      limactl start "$instance"
      ;;
    "")
      echo "devbox: Lima instance '$instance' does not exist; create it before retrying" >&2
      exit 1
      ;;
    *)
      echo "devbox: cannot start Lima instance '$instance' while it is '$status'" >&2
      exit 1
      ;;
  esac
  flock -u "$lock_fd" || true
  exec {lock_fd}>&-
  start_vm=false
fi

# These variables are the explicit host-to-guest allowlist. Provider
# credentials are conditionally forwarded below; CA-bundle values are static
# guest paths, not host file paths. Keep this list synchronized with its tests.
DEVBOX_ENV_VARS=(
  SSL_CERT_FILE
  REQUESTS_CA_BUNDLE
  NODE_EXTRA_CA_CERTS
  GEMINI_API_KEY
  GOOGLE_GENERATIVE_AI_API_KEY
  GH_TOKEN
  GITHUB_TOKEN
  CONTEXT7_API_KEY
  TAVILY_API_KEY
  IGLOO_MCP_COMMUNITY
  IGLOO_MCP_COMMUNITY_KEY
  IGLOO_MCP_APP_PASS
  IGLOO_MCP_APP_ID
  IGLOO_MCP_USERNAME
  IGLOO_MCP_PASSWORD
  GITLAB_HOST
  GITLAB_TOKEN
  LITEMAAS_API_KEY
  ENMAAS_URL
  ENMAAS_API_KEY
  OPENAI_API_KEY
  OCTO_OPEN_URL
  OCTO_OPEN_KEY
  ANTHROPIC_API_KEY
  ANTHROPIC_BASE_URL
  PRICETAG_ANTHROPIC_URL
  PRICETAG_HOSTED_URL
  PRICETAG_OPENAI_URL
  PRICETAG_API_KEY
  GOOGLE_CLOUD_PROJECT
  VERTEX_LOCATION
)

export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
export NODE_EXTRA_CA_CERTS="$SSL_CERT_FILE"

unset_if_empty() {
  local name
  for name in "$@"; do
    if [[ -z "${!name:-}" ]]; then
      unset "$name"
    fi
  done
}

# Normalize provider aliases and conditional credential groups before they
# cross the host-to-VM boundary.
if [[ -n "${GEMINI_API_KEY:-}" ]]; then
  export GOOGLE_GENERATIVE_AI_API_KEY="$GEMINI_API_KEY"
else
  unset GOOGLE_GENERATIVE_AI_API_KEY
fi

github_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [[ -z "$github_token" ]] && command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
fi
if [[ -n "$github_token" ]]; then
  export GH_TOKEN="$github_token"
  export GITHUB_TOKEN="$github_token"
else
  unset GH_TOKEN GITHUB_TOKEN
fi

unset_if_empty \
  CONTEXT7_API_KEY \
  TAVILY_API_KEY \
  LITEMAAS_API_KEY \
  OPENAI_API_KEY \
  ANTHROPIC_API_KEY \
  ANTHROPIC_BASE_URL

if [[ -n "${GITLAB_TOKEN:-}" ]]; then
  export GITLAB_HOST="${GITLAB_HOST:-gitlab.com}"
else
  unset GITLAB_HOST GITLAB_TOKEN
fi

octo_open_complete=true
if [[ -z "${OCTO_OPEN_URL:-}" || -z "${OCTO_OPEN_KEY:-}" ]]; then
  octo_open_complete=false
fi
if [[ "$octo_open_complete" != true ]]; then
  unset OCTO_OPEN_URL OCTO_OPEN_KEY
fi

enmaas_complete=true
if [[ -z "${ENMAAS_URL:-}" || -z "${ENMAAS_API_KEY:-}" ]]; then
  enmaas_complete=false
fi
if [[ "$enmaas_complete" != true ]]; then
  unset ENMAAS_URL ENMAAS_API_KEY
fi

igloo_env_vars=(
  IGLOO_MCP_COMMUNITY
  IGLOO_MCP_COMMUNITY_KEY
  IGLOO_MCP_APP_PASS
  IGLOO_MCP_APP_ID
  IGLOO_MCP_USERNAME
  IGLOO_MCP_PASSWORD
)
igloo_complete=true
for name in "${igloo_env_vars[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    igloo_complete=false
  fi
done
if [[ "$igloo_complete" != true ]]; then
  unset "${igloo_env_vars[@]}"
fi

pricetag_has_endpoint=false
for name in \
  PRICETAG_ANTHROPIC_URL \
  PRICETAG_HOSTED_URL \
  PRICETAG_OPENAI_URL; do
  if [[ -n "${!name:-}" ]]; then
    pricetag_has_endpoint=true
  else
    unset "$name"
  fi
done
if [[ -z "${PRICETAG_API_KEY:-}" || "$pricetag_has_endpoint" != true ]]; then
  unset \
    PRICETAG_API_KEY \
    PRICETAG_ANTHROPIC_URL \
    PRICETAG_HOSTED_URL \
    PRICETAG_OPENAI_URL
fi

if [[ -n "${GOOGLE_CLOUD_PROJECT:-}" && -n "${VERTEX_LOCATION:-}" ]]; then
  :
else
  unset GOOGLE_CLOUD_PROJECT VERTEX_LOCATION
fi

# A strict block-all plus allowlist avoids leaking unrelated host variables
# into the VM while explicitly permitting provider variables that Lima's
# default shell environment filter normally blocks (for example *_API_KEY).
allowlist="$(IFS=,; printf '%s' "${DEVBOX_ENV_VARS[*]}")"
export LIMA_SHELLENV_BLOCK='*'
export LIMA_SHELLENV_ALLOW="$allowlist"

shell_args=(shell --preserve-env)
if [[ -n "$workdir" ]]; then
  shell_args+=(--workdir "$workdir")
fi

# Generate the runtime overlay inside the VM immediately before OpenCode starts.
# The generator serializes only {env:...} references, never credential values;
# keeping it guest-side also avoids requiring host jq/Python or modifying the
# mounted global OpenCode config. Every OpenCode CLI form (including `run`)
# enters through this path, so the first command starts the shared service with
# the same config that subsequent project sessions receive.
if [[ "$opencode_debug" != unchanged || "${1:-}" == opencode ]]; then
  # Resolve the guest-local service preference before starting OpenCode; the
  # runtime config is still generated immediately before each OpenCode client.
  # shellcheck disable=SC2016 # This command string is evaluated inside the VM.
  remote_command='
set -euo pipefail
debug_mode="$1"
config_script="$2"
debug_script="$3"
shift 3
effective_debug="$(bash "$debug_script" "$debug_mode")"
if [[ "$effective_debug" == enabled ]]; then
  export OPENCODE_LOG_LEVEL=DEBUG
else
  unset OPENCODE_LOG_LEVEL
fi
if [[ "${1:-}" == opencode ]]; then
  shift
  if [[ "$effective_debug" == enabled ]]; then
    umask 077
  fi
  OPENCODE_CONFIG_CONTENT="$(python3 "$config_script")"
  export OPENCODE_CONFIG_CONTENT
  exec opencode "$@"
fi
if (($# == 0)); then
  exec bash -l
fi
exec "$@"
'
  exec limactl "${shell_args[@]}" "$instance" bash -c "$remote_command" \
    bash "$opencode_debug" "$repo_root/lima/opencode_config.py" \
    "$repo_root/lima/opencode-debug-logs.sh" "$@"
fi
exec limactl "${shell_args[@]}" "$instance" "$@"
