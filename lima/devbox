#!/usr/bin/env bash
# VM-native entry point called by the top-level devbox launcher.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
instance="${DEVBOX_LIMA_INSTANCE:-devbox}"
action="${1:-run}"
shift || true
opencode_debug=unchanged
if [[ "${1:-}" == --opencode-debug=* ]]; then
  opencode_debug="${1#--opencode-debug=}"
  case "$opencode_debug" in
    unchanged | enabled | disabled) ;;
    *)
      echo "devbox: invalid internal OpenCode debug mode" >&2
      exit 2
      ;;
  esac
  shift
  if [[ "${1:-}" != -- ]]; then
    echo "devbox: internal OpenCode debug option is missing its argument delimiter" >&2
    exit 2
  fi
  shift
fi
command=("$@")
if [[ "$opencode_debug" != unchanged && ( "$action" == stop || "$action" == delete ) ]]; then
  echo "devbox: OpenCode debug flags cannot be used with --stop or --delete" >&2
  exit 2
fi
guest_workdir=""
delete_restore_protection=false
create_src_root=""
create_repo_path=""
old_vm_was_protected=false

if ! command -v limactl >/dev/null 2>&1; then
  echo "devbox: limactl is not installed or not on PATH" >&2
  exit 127
fi

lock_root="${XDG_CACHE_HOME:-$HOME/.cache}/devbox/locks"
lock_file="$lock_root/lima-runtime.lock"
lock_fd=""

acquire_lima_lock() {
  local fd
  if ! mkdir -p "$lock_root" || ! chmod 700 "$lock_root" \
    || ! exec {fd}>"$lock_file" || ! chmod 600 "$lock_file"; then
    echo "devbox: could not create or secure Lima lifecycle lock '$lock_file'" >&2
    return 1
  fi
  if ! flock "$fd"; then
    echo "devbox: could not acquire Lima lifecycle lock '$lock_file'" >&2
    exec {fd}>&-
    return 1
  fi
  lock_fd="$fd"
}

release_lima_lock() {
  if [[ -n "$lock_fd" ]]; then
    flock -u "$lock_fd" || true
    exec {lock_fd}>&-
    lock_fd=""
  fi
}

trap release_lima_lock EXIT

lima_status() {
  local instances name instance_status status=""
  if ! instances="$(limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null)"; then
    echo "devbox: could not inspect Lima instance '$instance'" >&2
    return 1
  fi
  while read -r name instance_status; do
    if [[ "$name" == "$instance" ]]; then
      status="$instance_status"
      break
    fi
  done <<<"$instances"
  printf '%s\n' "$status"
}

lima_protection_state() {
  local instances name protection_state
  if ! instances="$(limactl list --format '{{.Name}} {{.Protected}}' 2>/dev/null)"; then
    echo "devbox: could not verify protection state for Lima instance '$instance'" >&2
    return 1
  fi
  while read -r name protection_state; do
    if [[ "$name" == "$instance" ]]; then
      case "$protection_state" in
        true | false)
          printf '%s\n' "$protection_state"
          return 0
          ;;
        *)
          echo "devbox: Lima returned an invalid protection state for '$instance'" >&2
          return 1
          ;;
      esac
    fi
  done <<<"$instances"
  echo "devbox: could not verify protection state for Lima instance '$instance'" >&2
  return 1
}

lima_instance_exists() {
  local instances name
  if ! instances="$(limactl list --format '{{.Name}}' 2>/dev/null)"; then
    return 2
  fi
  while read -r name; do
    if [[ "$name" == "$instance" ]]; then
      return 0
    fi
  done <<<"$instances"
  return 1
}

report_protection_warning() {
  local reason="$1"
  printf 'WARNING: %s for Lima instance %q.\n' "$reason" "$instance" >&2 || true
  printf '       If the instance still exists, restore protection manually with: limactl protect %q\n' \
    "$instance" >&2 || true
}

restore_lima_protection() {
  local reason="$1"
  if limactl protect -- "$instance"; then
    printf 'devbox: %s; protection is in place for Lima instance %q.\n' \
      "$reason" "$instance" >&2 || true
    return 0
  fi
  report_protection_warning "$reason; protection could not be restored"
  return 1
}

handle_lifecycle_delete_signal() {
  local signal_name="$1" exit_status instance_status
  case "$signal_name" in
    INT) exit_status=130 ;;
    TERM) exit_status=143 ;;
    HUP) exit_status=129 ;;
    QUIT) exit_status=131 ;;
    PIPE) exit_status=141 ;;
    *) exit_status=1 ;;
  esac

  # Prevent repeated signals from interrupting best-effort protection repair.
  trap '' INT TERM HUP QUIT PIPE
  if [[ "$delete_restore_protection" == true ]]; then
    if lima_instance_exists; then
      restore_lima_protection "deletion interrupted by SIG$signal_name" || true
    else
      instance_status=$?
      if [[ "$instance_status" -eq 2 ]]; then
        report_protection_warning \
          "deletion interrupted by SIG$signal_name; could not verify whether protection needs restoration"
      fi
    fi
  fi
  # The existing EXIT trap still releases the lifecycle lock.
  exit "$exit_status"
}

validate_create_inputs() {
  local src_root repo_path template_path
  src_root="$(realpath -m "$HOME/src")" || {
    echo "devbox: could not resolve the host ~/src mount" >&2
    return 1
  }
  repo_path="$(realpath -e "$HERE/..")" || {
    echo "devbox: could not resolve the devbox repository path" >&2
    return 1
  }
  case "$repo_path/" in
    "$src_root/"*) ;;
    *)
      echo "devbox: the my-sandbox checkout must be under '$src_root' to create the Lima VM" >&2
      echo "       Move or clone this checkout under ~/src and retry." >&2
      return 1
      ;;
  esac

  template_path="$HERE/devbox.yaml"
  if [[ ! -f "$template_path" ]]; then
    echo "devbox: Lima template '$template_path' is missing or not a regular file" >&2
    return 1
  fi
  if [[ ! -r "$template_path" ]]; then
    echo "devbox: Lima template '$template_path' is not readable" >&2
    return 1
  fi

  create_src_root="$src_root"
  create_repo_path="$repo_path"
}

create_instance() {
  local src_root repo_path kb_path git_user_name git_user_email
  validate_create_inputs || return 1
  src_root="$create_src_root"
  repo_path="$create_repo_path"
  kb_path="$(realpath -m "$HOME/kb")" || {
    echo "devbox: could not resolve the host ~/kb mount" >&2
    return 1
  }
  git_user_name="$(git config --global user.name || true)"
  git_user_email="$(git config --global user.email || true)"

  echo "==> Creating and starting Lima VM '$instance'"
  if ! limactl start --yes --name "$instance" "$HERE/devbox.yaml" \
    --param "SrcPath=$src_root" \
    --param "RepoPath=$repo_path" \
    --param "KbPath=$kb_path" \
    --param "GitUserName=$git_user_name" \
    --param "GitUserEmail=$git_user_email"; then
    echo "devbox: could not create Lima instance '$instance'; inspect the Lima logs and '$HERE/README.md'" >&2
    return 1
  fi
}

ensure_running() {
  local status
  if [[ $# -gt 0 ]]; then
    status="$1"
  else
    status="$(lima_status)" || return
  fi
  case "$status" in
    Running)
      return 0
      ;;
    Stopped)
      echo "==> Starting Lima VM '$instance'"
      if ! limactl start "$instance"; then
        echo "devbox: could not start Lima instance '$instance'" >&2
        echo "       Inspect it with 'limactl list' or recreate it with 'devbox --recreate'." >&2
        return 1
      fi
      ;;
    "")
      create_instance
      ;;
    *)
      echo "devbox: cannot start Lima instance '$instance' while it is '$status'" >&2
      return 1
      ;;
  esac
}

require_no_command() {
  if [[ ${#command[@]} -ne 0 ]]; then
    local option
    case "$action" in
      stop) option=--stop ;;
      delete) option=--delete ;;
      *) option="$action" ;;
    esac
    echo "devbox: '$option' does not accept a command" >&2
    exit 2
  fi
}

provisioning_fingerprint() {
  local manifest_sha system_sha user_sha state_seed_sha tool_sha assets_sha guest_user
  local asset_hashes
  local -a sources=(
    "$HERE/devbox-go"
    "$HERE/check_toolchain.py"
    "$HERE/semble"
  )
  local -a guest_assets=(
    /var/lib/devbox-vm/tool-assets/devbox-go
    /var/lib/devbox-vm/tool-assets/check_toolchain.py
    /var/lib/devbox-vm/tool-assets/semble
  )

  sha256_file() {
    sha256sum "$1" | awk '{print $1}'
  }

  manifest_sha="$(sha256_file "$HERE/tool-versions.json")"
  guest_user="$(id -un)"
  escaped_guest_user="${guest_user//\\/\\\\}"
  escaped_guest_user="${escaped_guest_user//&/\\&}"
  escaped_guest_user="${escaped_guest_user//|/\\|}"
  system_sha="$(sed "s|{{\\.User}}|$escaped_guest_user|g" "$HERE/provision-system.sh" \
    | sha256sum | awk '{print $1}')"
  user_sha="$(sha256_file "$HERE/provision-user.sh")"
  state_seed_sha="$(sha256_file "$HERE/seed-opencode-state.py")"
  tool_sha="$(sha256_file "$HERE/provision-tools.sh")"
  asset_hashes=""
  local index
  for index in "${!sources[@]}"; do
    asset_hashes+="$(sha256_file "${sources[$index]}")  ${guest_assets[$index]}"$'\n'
  done
  assets_sha="$(printf '%s' "$asset_hashes" | sha256sum | awk '{print $1}')"
  printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$manifest_sha" "$system_sha" "$user_sha" "$state_seed_sha" \
    "$tool_sha" "$assets_sha" \
    | sha256sum | awk '{print $1}'
}

warn_stale_provisioning() {
  local expected actual
  expected="$(provisioning_fingerprint)"
  if ! actual="$(timeout 15 limactl shell "$instance" sh -lc \
    'cat ~/.local/share/devbox-toolchain/provisioning.fingerprint' 2>/dev/null)"; then
    actual=""
  fi
  if [[ "$actual" != "$expected" ]]; then
    echo "devbox: Lima VM '$instance' provisioning is stale or cannot be verified." >&2
    echo "       Run 'devbox --stop' and then 'devbox' to apply tool/manifest changes." >&2
    echo "       Use 'devbox --recreate' if template/provisioner changes are not reflected; VM-local state will be lost." >&2
    echo "       See '$HERE/README.md' for recovery and data-boundary details." >&2
  fi
}

resolve_guest_workdir() {
  local current_dir host_root suffix relative index
  local host_home guest_home src_root
  current_dir="$(realpath -e "$PWD")" || {
    echo "devbox: cannot resolve current directory '$PWD'" >&2
    return 1
  }
  host_home="$(realpath -e "$HOME")"
  guest_home="/home/$(id -un).guest"
  src_root="$(realpath -e "$HOME/src" 2>/dev/null || true)"

  local -a host_roots=() guest_roots=()
  if [[ -n "$src_root" && -d "$src_root" ]]; then
    host_roots+=("$src_root")
    guest_roots+=("$src_root")
  fi
  for relative in \
    kb \
    .config/opencode \
    .config/gh \
    .config/gcloud \
    .config/acli \
    .config/gws \
    .local/share/opencode \
    .local/state/opencode \
    .local/state/devbox-opencode; do
    host_root="$host_home/$relative"
    if [[ -d "$host_root" ]]; then
      host_root="$(realpath -e "$host_root")"
      host_roots+=("$host_root")
      case "$relative" in
        .local/state/opencode)
          guest_roots+=("$guest_home/.host-config/local/state/opencode-seed")
          ;;
        .local/state/devbox-opencode)
          guest_roots+=("$guest_home/.host-config/local/state/devbox-opencode")
          ;;
        *) guest_roots+=("$guest_home/$relative") ;;
      esac
    fi
  done
  host_root="$host_home/.agents"
  if [[ -d "$host_root" ]]; then
    host_roots+=("$(realpath -e "$host_root")")
    guest_roots+=("$guest_home/.host-config/agents")
  fi

  for index in "${!host_roots[@]}"; do
    host_root="${host_roots[$index]}"
    case "$current_dir" in
      "$host_root")
        printf '%s\n' "${guest_roots[$index]}"
        return 0
        ;;
      "$host_root"/*)
        suffix="${current_dir#"$host_root"}"
        printf '%s\n' "${guest_roots[$index]}$suffix"
        return 0
        ;;
    esac
  done

  echo "devbox: '$current_dir' is outside the paths mounted in Lima." >&2
  echo "       Move to a directory under ~/src (or another mounted directory) and retry." >&2
  echo "       Host mount configuration is documented in '$HERE/README.md'." >&2
  return 1
}

run_guest_command() {
  local shell_args=(--no-start)
  if [[ -n "$guest_workdir" ]]; then
    shell_args+=(--workdir "$guest_workdir")
  fi
  if [[ "$opencode_debug" != unchanged ]]; then
    shell_args+=(--opencode-debug "$opencode_debug")
  fi
  exec "$HERE/devbox-shell" "${shell_args[@]}" -- "${command[@]}"
}

run_launcher() {
  local initial_status
  guest_workdir="$(resolve_guest_workdir)" || return 1
  initial_status="$(lima_status)" || return 1
  ensure_running "$initial_status" || return 1

  # Provisioning runs on VM startup. Compare the stamp before leaving this
  # serialized section when the VM was already up; a stopped VM applies the
  # current manifest as part of its start sequence.
  if [[ "$initial_status" == Running ]]; then
    warn_stale_provisioning
  fi
  release_lima_lock
  # The VM is already running under the lifecycle lock. Do not ask the shell
  # helper to start it again after unlocking: a concurrent --stop must win.
  run_guest_command
}

prepare_lifecycle_command() {
  # Recreate always enters the fresh VM, and must reject an unmapped workdir
  # or unusable checkout before deleting an existing instance.
  guest_workdir="$(resolve_guest_workdir)" || return 1
  validate_create_inputs
}

run_lifecycle_command() {
  release_lima_lock
  # Recreate always enters the new VM. With no command, the guest runner opens
  # its ordinary interactive shell (including the debug wrapper, if requested).
  run_guest_command
}

delete_existing_instance() {
  local status protection_state limactl_status
  status="$(lima_status)" || return 1
  if [[ -z "$status" ]]; then
    echo "==> Lima VM '$instance' does not exist; nothing to delete"
    return 0
  fi

  protection_state="$(lima_protection_state)" || return 1
  old_vm_was_protected="$protection_state"
  delete_restore_protection="$protection_state"
  trap 'handle_lifecycle_delete_signal INT' INT
  trap 'handle_lifecycle_delete_signal TERM' TERM
  trap 'handle_lifecycle_delete_signal HUP' HUP
  trap 'handle_lifecycle_delete_signal QUIT' QUIT
  trap 'handle_lifecycle_delete_signal PIPE' PIPE
  echo "==> Deleting Lima VM '$instance' (including its protection)"
  if [[ "$protection_state" == true ]]; then
    if limactl unprotect -- "$instance"; then
      :
    else
      limactl_status=$?
      restore_lima_protection "unprotect failed" || true
      trap - INT TERM HUP QUIT PIPE
      delete_restore_protection=false
      return "$limactl_status"
    fi
  fi
  if limactl delete --force -- "$instance"; then
    :
  else
    limactl_status=$?
    if [[ "$protection_state" == true ]]; then
      restore_lima_protection "deletion failed" || true
    else
      printf 'devbox: could not delete Lima instance %q\n' "$instance" >&2 || true
    fi
    trap - INT TERM HUP QUIT PIPE
    delete_restore_protection=false
    return "$limactl_status"
  fi
  trap - INT TERM HUP QUIT PIPE
  delete_restore_protection=false
}

if ! acquire_lima_lock; then
  exit 1
fi

case "$action" in
  stop)
    require_no_command
    status="$(lima_status)" || exit 1
    if [[ -z "$status" ]]; then
      echo "devbox: Lima instance '$instance' does not exist" >&2
      exit 1
    elif [[ "$status" == Running ]]; then
      echo "==> Stopping Lima VM '$instance'"
      limactl stop "$instance"
    elif [[ "$status" == Stopped ]]; then
      echo "==> Lima VM '$instance' is already stopped"
    else
      echo "devbox: cannot stop Lima instance '$instance' while it is '$status'" >&2
      exit 1
    fi
    ;;
  recreate)
    prepare_lifecycle_command || exit 1
    delete_existing_instance || exit $?
    create_instance || exit $?
    if [[ "$old_vm_was_protected" == true ]]; then
      printf 'devbox: fresh Lima VM %q is unprotected. Protect it with: limactl protect %q\n' \
        "$instance" "$instance" >&2
    fi
    run_lifecycle_command
    ;;
  delete)
    require_no_command
    delete_existing_instance || exit $?
    ;;
  run)
    run_launcher
    ;;
  *)
    echo "devbox: internal error: unknown action '$action'" >&2
    exit 2
    ;;
esac
