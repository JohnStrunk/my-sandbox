#!/usr/bin/env bash
# Single-command launcher: OpenShell replacement for devcontainer launch.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME="${1:-sandbox}"

openshell status >/dev/null 2>&1 || {
  echo "OpenShell Gateway is not reachable. Ensure openshell-gateway is running and setup-provider.sh has been executed." >&2
  exit 1
}

echo "==> Resolving active gateway providers"
PROVIDERS=()
for p in \
  gcloud \
  github \
  litemaas \
  ; do
  if openshell provider get "$p" >/dev/null 2>&1; then
    echo "  Found provider: $p"
    PROVIDERS+=("--provider" "$p")
  fi
done

echo "==> Creating sandbox '$NAME'"
openshell sandbox create \
  --name "$NAME" \
  --from "$HERE/sandbox" \
  --policy "$HERE/sandbox-policy.yaml" \
  "${PROVIDERS[@]}" \
  --env "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT:-}" \
  --env "VERTEX_LOCATION=${VERTEX_LOCATION:-global}" \
  -- echo

echo "==> Uploading settings & customization"
openshell sandbox upload "$NAME" "$HOME/.config/opencode" "/sandbox/.config/"
openshell sandbox upload "$NAME" "$HOME/.local/state/opencode/model.json" "/sandbox/.local/state/opencode/"
openshell sandbox upload "$NAME" "$HERE/opencode.json" "/sandbox/"

exec openshell sandbox connect "$NAME"
